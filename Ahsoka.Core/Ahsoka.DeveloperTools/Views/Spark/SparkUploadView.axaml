<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             xmlns:material="using:Material.Icons.Avalonia" Background="#33555555"
             x:Class="Ahsoka.DeveloperTools.Views.SparkUploadView">
	<UserControl.Styles>
		<StyleInclude Source="/Styles/UserInputStyles.axaml" />
	</UserControl.Styles>
	<Grid VerticalAlignment="Center" HorizontalAlignment="Center">
		<Border BoxShadow="5 5 10 2 DarkGray" BorderBrush="DarkGray" BorderThickness="1" Background="White">
			<StackPanel >
				<Border BorderBrush="Gainsboro" Background="WhiteSmoke" BorderThickness="0,0,0,1" DockPanel.Dock="Top">
					<DockPanel LastChildFill="False">
						<TextBlock Foreground="DodgerBlue" FontSize="16" Margin="0" Padding="10">UPLOAD PACKAGE TO SPARK</TextBlock>
						<Button  DockPanel.Dock="Right" Content="Cancel" Command="{Binding Cancel}" />
						<Button DockPanel.Dock="Right" Content="Ok" Command="{Binding BeginUpload}" />
					</DockPanel>
				</Border>
				<Border Margin="20,20,20,20" Padding="3" BorderBrush="WhiteSmoke" BorderThickness="0,0,0,0">
					<Grid Margin="5" ColumnDefinitions="125,Auto" RowDefinitions="*,*,*,*,*">
						<TextBlock Text="Channel Name:" Grid.Row="0" Grid.Column="0"
								   ToolTip.Tip="The channel name is the name which the display subscribes to in order to recieve OTA Updates.  Its a combination of the Package Name and Application ID."/>
						<TextBox Background="WhiteSmoke" Text="{Binding UploadInfo.ChannelName}" Grid.Row="0" Width="450" IsReadOnly="True" TextWrapping="NoWrap" Grid.Column="1" />
						
						<TextBlock Text="Release Name:" Grid.Row="1" Grid.Column="0"/>
						<TextBox  Background="WhiteSmoke" Text="{Binding UploadInfo.ReleaseName}" Grid.Row="1" Width="300" IsReadOnly="True" Grid.Column="1" />
						
						<TextBlock Text="Version:" Grid.Row="2" Grid.Column="0"/>
						<TextBox Text="{Binding UploadInfo.ContainerVersion}" Width="300" Grid.Row="2" Grid.Column="1" />

						<TextBlock Text="Release Notes:" Margin="5,8,0,0" Grid.Row="3" Grid.Column="0" VerticalAlignment="Top"/>
						<TextBox Text="{Binding UploadInfo.ReleaseNotes}" Width="450" Height="280" Grid.Row="3" Grid.Column="1" AcceptsReturn="True"/>

						<TextBlock Margin="0" Grid.Row="4" HorizontalAlignment="Center" Foreground="Gray" Grid.ColumnSpan="2" Padding="10">*Note:Spark Tools Require Administrator Login</TextBlock>
					</Grid>
				</Border>
			</StackPanel>
		</Border>
	</Grid>
</UserControl>

