<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net7.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>



	<ItemGroup>
		<ProjectReference Include="..\Ahsoka.Core\Ahsoka.Core.csproj" />
		<ProjectReference Include="..\ThirdParty\DiscUtils\Library\DiscUtils.Ext\DiscUtils.Ext.csproj" />
		<PackageReference Include="protobuf-net" Version="3.2.30" />
		<PackageReference Include="protobuf-net.BuildTools" Version="3.2.33">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<AdditionalFiles Include="..\..\Ahsoka.Proto\Installer\*.proto">
			<Link>Proto\%(RecursiveDir)%(Filename)%(Extension)</Link>
		</AdditionalFiles>
	</ItemGroup>
</Project>
