	<PropertyGroup Label="Debian Packaging">
		<PublishSelfContained>true</PublishSelfContained>
		<PackageDir>..\..\SparkUpload</PackageDir>
	</PropertyGroup>
	
	<ItemGroup Label="Debian Packaging">
		<Content Include="Ubuntu\Ahsoka.CustomerTools.desktop" CopyToPublishDirectory="Always">
			<LinuxPath>/usr/share/applications/OpenPV.DeveloperToolkit.desktop</LinuxPath>
		</Content>
		<Content Include="Assets\OpenPV-Icon.ico" CopyToPublishDirectory="Always">
			<LinuxPath>/usr/share/icons/OpenPV.DeveloperToolkit.ico</LinuxPath>
		</Content>
		<DebDotNetDependencies Include="libc6,xterm,xdg-utils" />
	</ItemGroup>
	
	<ItemGroup>
	  <EmbeddedResource Update="Properties\Resources.resx">
	    <Generator>ResXFileCodeGenerator</Generator>
	    <LastGenOutput>Resources.Designer.cs</LastGenOutput>
	  </EmbeddedResource>
	</ItemGroup>
	
	<ItemGroup>
