<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<UserSecretsId>5861d827-1f17-41c9-9344-c2616ea52eb6</UserSecretsId>
	</PropertyGroup>

	<!--Disable Build Outputs-->
	<Target Name="Build" />
	<Target Name="Rebuild" />

	<PropertyGroup>
		<SecretPath>$(appdata)\Microsoft\UserSecrets\$(UserSecretsId)\secrets.json</SecretPath>
		<OpenViewBSP>2.2024-02-27T105810.otatest.023e22e</OpenViewBSP>
	</PropertyGroup>


	<Target Name="Clean BuildOutputs" BeforeTargets="BeforeClean">
		<Message Text="Cleaning Downloads" Importance="high" />
		<RemoveDir Directories="$(SolutionDir)FirmwareDownload" />
	</Target>
	
	<Target Name="DownloadBSPs" AfterTargets="PostBuildEvent">
		<!--This section Downloads the BSP to be included in the OpenView Package the Version used is specfied in the OpenViewBSP Property Above.
		Note that this requires that you have the SparkLogin and SparkPassword stored in your local Secrets file...same values used for tests.-->

		<JsonPeek ContentPath="$(SecretPath)" Query=".SparkLogin">
			<Output TaskParameter="Result" ItemName="SparkLogin" />
		</JsonPeek>
		<JsonPeek ContentPath="$(SecretPath)" Query=".SparkPassword">
			<Output TaskParameter="Result" ItemName="SparkPassword" />
		</JsonPeek>
		<PropertyGroup>
			<SparkLogin>@(SparkLogin)</SparkLogin>
			<SparkPassword>@(SparkPassword)</SparkPassword>
		</PropertyGroup>
		<Message Importance="low" Text=" Value is $(SparkLogin) $(SparkPassword)" />
		<Exec Command="dotnet tool update --global  EnovationCloud.CommandLine" />
		<Copy SourceFiles="OpenView.upgradeinfo.json" DestinationFiles="$(SolutionDir)FirmwareDownload\OpenViewLinux_TargetSupport\Firmware\OpenView.upgradeinfo.json" />
		<DownloadFile DestinationFolder="$(SolutionDir)FirmwareDownload\OpenViewLinux_TargetSupport\Firmware\" SourceUrl="https://powervisionsparkprod.blob.core.windows.net/ahsoka-public-downloads/OpenView/BSPUpdate/V3.0/upgrade.$(OpenViewBSP).zip" />
		<Exec WorkingDirectory="$(SolutionDir)" Command="EnovationCloud.CommandLine --DownloadFromSpark  sparkserviceprod.azurewebsites.net $(SparkLogin) &quot;$(SparkPassword)&quot; &quot;$(SolutionDir)FirmwareDownload\OpenViewLinux_TargetSupport\Firmware&quot; &quot;OpenPV Distribution&quot; $(OpenViewBSP) image.$(OpenViewBSP).zip" />
		<Exec WorkingDirectory="$(SolutionDir)" Command="EnovationCloud.CommandLine --DownloadFromSpark  sparkserviceprod.azurewebsites.net $(SparkLogin) &quot;$(SparkPassword)&quot; &quot;$(SolutionDir)FirmwareDownload\OpenViewLinux_TargetSupport\Firmware&quot; &quot;OpenPV Distribution Upgrade&quot; $(OpenViewBSP) ota.$(OpenViewBSP).zip" />
	</Target>

	<ItemGroup>
		<PackageReference Include="JsonPeek" Version="1.2.0" />
		<PackageReference Include="GitVersion.MsBuild" Version="5.12.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="6.0.1" />
	</ItemGroup>

</Project>
