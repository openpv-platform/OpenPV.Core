<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<!--Disable Build Outputs-->
	<Target Name="Build" />
	<Target Name="Rebuild" />

	<PropertyGroup>
		<PlatformSupportRoot>$(SolutionDir)..\</PlatformSupportRoot>
	</PropertyGroup>


	<!--We no longer nse the Nuget CLI for Generation but Generate a Package if Needed -->
	<Target Name="CreateCoreNugetPackages" AfterTargets="PostBuildEvent">

		<!--Create Ahsoka Windows Command Line Nuget Package....must happen AFTER the publish of the Command line for Windows and Mac -->
		<Exec Command="dotnet pack ../Ahsoka.Core/Ahsoka.Core.csproj" />
		<Exec Command="dotnet pack ../Ahsoka.CommandLine/Ahsoka.CommandLine.csproj" />
		<Exec Command="dotnet pack ../Ahsoka.Core.Drawing/Ahsoka.Core.Drawing.csproj" />
		<Exec Command="dotnet pack ../Ahsoka.DeveloperTools.Core/Ahsoka.DeveloperTools.Core.csproj" />
		
		<Exec Command="dotnet pack ../Ahsoka.Core/Ahsoka.Core.csproj -p:IncludeSymbols=true -p:SymbolPackageFormat=snupkg" />
		<Exec Command="dotnet pack ../Ahsoka.CommandLine/Ahsoka.CommandLine.csproj -p:IncludeSymbols=true -p:SymbolPackageFormat=snupkg" />
		<Exec Command="dotnet pack ../Ahsoka.Core.Drawing/Ahsoka.Core.Drawing.csproj -p:IncludeSymbols=true -p:SymbolPackageFormat=snupkg" />
		<Exec Command="dotnet pack ../Ahsoka.DeveloperTools.Core/Ahsoka.DeveloperTools.Core.csproj -p:IncludeSymbols=true -p:SymbolPackageFormat=snupkg" />

	</Target>


	<ItemGroup>
		<PackageReference Include="GitVersion.MsBuild" Version="[5.12.0]">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

</Project>
