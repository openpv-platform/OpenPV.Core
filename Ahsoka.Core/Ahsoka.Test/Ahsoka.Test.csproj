<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<IsPackable>false</IsPackable>
		<PlatformTarget>AnyCPU</PlatformTarget>
		<UserSecretsId>5861d827-1f17-41c9-9344-c2616ea52eb6</UserSecretsId>
		<NoWarn>CS0618</NoWarn> <!--For Legacy Calls-->
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
		<PlatformTarget>x64</PlatformTarget>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
		<PlatformTarget>x64</PlatformTarget>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="8.0.0" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
		<PackageReference Include="MSTest.TestAdapter" Version="3.6.0" />
		<PackageReference Include="MSTest.TestFramework" Version="3.6.0" />
		<PackageReference Include="NuGet.Protocol" Version="6.11.0" />
		<DotNetCliToolReference Include="Microsoft.Extensions.SecretManager.Tools" Version="1.0.1" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Ahsoka.Core\Ahsoka.DeveloperTools\Ahsoka.DeveloperTools.csproj" />
		<ProjectReference Include="..\Ahsoka.Extension.Test\Ahsoka.Extension.Test.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\..\Ahsoka.Demo\Ahsoka.CS.Cairo\**\*.*" Exclude="..\..\Ahsoka.Demo\Ahsoka.CS.Cairo\bin\**\*.*;..\..\Ahsoka.Demo\Ahsoka.CS.Cairo\obj\**\*.*">
			<Link>AhsokaCairo\%(RecursiveDir)%(Filename)%(Extension)</Link>
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<ItemGroup>
	  <Content Include="..\Ahsoka.DownloadBSP\OpenView.upgradeinfo.json" Link="OpenView.upgradeinfo.json" />
	</ItemGroup>

	<ItemGroup>
		<Compile Update="Properties\Resources.Designer.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>Resources.resx</DependentUpon>
		</Compile>
	</ItemGroup>


	<Target Name="ControlBuild" AfterTargets="PostBuildEvent">
		<Message Text="Copy Files to Extensions Folder @ $(UxPath)" Importance="high" />
		<Copy SourceFiles="$(SolutionDir)\Ahsoka.Core\Ahsoka.Test\bin\$(Configuration)\$(TargetFramework)\Ahsoka.Extension.Test.dll" DestinationFiles="$(SolutionDir)\Ahsoka.Core\Ahsoka.Test\bin\$(Configuration)\$(TargetFramework)\ExtensionTests\Test Extension\lib\Ahsoka.Extension.Test.dll" />
	</Target>


	<ItemGroup>
		<EmbeddedResource Update="Properties\Resources.resx">
			<Generator>ResXFileCodeGenerator</Generator>
			<LastGenOutput>Resources.Designer.cs</LastGenOutput>
		</EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
		<None Update="Ahsoka\Resources\exampleCert\ca_root_cert.pem">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Update="Ahsoka\Resources\exampleCert\gateway_cert.pem">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Update="Ahsoka\Resources\exampleCert\gateway_key.pkcs8">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Update="BuildFolder\ApplicationOutput\TestOutput.txt">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="BuildFolder\OpenLinuxST.PackageInfo.json">
		  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="BuildFolder\STDemoPackage.1.cancalibration.json">
		  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="ExtensionTests\Ahsoka.Extensions.Core.extensioninfo.json">
		  <CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="GitVersion.MsBuild" Version="5.12.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

</Project>
