<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
           	 xmlns:sys="clr-namespace:System;assembly=mscorlib"
		     mc:Ignorable="d" d:DesignWidth="1085" d:DesignHeight="450"
             xmlns:material="using:Material.Icons.Avalonia"
             x:Class="Ahsoka.CustomerTools.Views.ServiceOptionsView">

	<Grid HorizontalAlignment="Stretch" DataContext="{Binding SelectedPackage.DataServiceViewModel}" >
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*"/>
			<ColumnDefinition Width="250"/>
		</Grid.ColumnDefinitions>

		<Grid.Styles>
			<StyleInclude Source="/Styles/UserInputStyles.axaml" />
		</Grid.Styles>
		
		<StackPanel  Margin="-15" Grid.Column="1"
			HorizontalAlignment="Center">
			<TextBlock FontSize="18"
				   VerticalAlignment="Top"
				   HorizontalAlignment="Center"
				   Margin="12" IsVisible="False"
				   Foreground="DimGray"
			   Text=" Service Actions "/>
		
		</StackPanel>

		<Grid Margin="5,20,25,5" ColumnDefinitions="205,auto,*" RowDefinitions="auto,auto,auto,auto,*,20">

			<TextBlock Margin="15,3,0,3" Text="Custom Service Config:" Grid.Row="0" Grid.Column="0"/>
			<StackPanel Grid.ColumnSpan="2" VerticalAlignment="Center" Orientation="Horizontal" Grid.Column="1" Grid.Row="0">
				<ComboBox VerticalAlignment="Center" ItemsSource="{Binding ServiceEnableDisableItems}" 
							  SelectedItem="{Binding CustomServiceEnabled}" Width="175" />
				<TextBlock Text="Use this custom service definition instead of the built in service definitions. (required for DataService Permissions)"
						   TextWrapping="Wrap" MaxWidth="375" Foreground="DimGray" HorizontalAlignment="Left"
						   Grid.Row="0" Grid.Column="2"/>
			</StackPanel>
			
			<Border BoxShadow="2 2 2 1 Gainsboro" BorderBrush="Gainsboro" BorderThickness="1"
					Margin="20,20,0,0"
					Grid.ColumnSpan="3" Grid.Row="4"
					HorizontalAlignment="Stretch">

				<Grid ColumnDefinitions="2*,3*" RowDefinitions="auto,*">
					<TextBlock  FontSize="16"  Margin="18,10,0,0" Text="Configured Services" VerticalAlignment="Top"/>

					<StackPanel IsVisible="False" Orientation="Horizontal" HorizontalAlignment="Right">
						<Button  Classes="link" Margin="18,8,0,0"
								Height="24" FontStyle="Italic"
								HorizontalAlignment="Right"
								VerticalContentAlignment="Center"
								Command="{Binding SelectedService.SelectAll}"
								Foreground="SteelBlue" Background="White"
								Content="Add"/>
						<Button  Classes="link" Margin="0,8,18,0" Grid.Column="2"
							 Height="24" FontStyle="Italic"
							 HorizontalAlignment="Right"
							 VerticalContentAlignment="Center"
							 Command="{Binding SelectedService.UnselectAll}"
							 Foreground="SteelBlue" Background="White"
							 Content="Remove"/>
					</StackPanel>
					<Border VerticalAlignment="Stretch" Grid.Row="1" Margin="20,5,20,20" BorderBrush="Gainsboro" BorderThickness="1">
						<ListBox  ItemsSource="{Binding Services}" SelectedItem="{Binding SelectedService}" Background="Transparent" >
							<ListBox.ItemTemplate>
								<DataTemplate>
									<Grid ColumnDefinitions="30,*,auto" Margin="-5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
										<Button  Margin="0,3,0,0" HorizontalAlignment="Left"
												 BorderThickness="0"
												 Width="24"
												 Height="24"
												 VerticalContentAlignment="Center"
												 Command="{Binding IncludeChanged}">
											<Grid>
												<material:MaterialIcon IsVisible="{Binding IsIncluded}" Width="20" Height="20" Foreground="SteelBlue" Kind="CheckboxMarked"></material:MaterialIcon>
												<material:MaterialIcon IsVisible="{Binding !IsIncluded}" Width="20" Height="20" Foreground="Gray" Kind="CheckboxBlank"></material:MaterialIcon>
											</Grid>
										</Button>
										<TextBlock Text="{Binding ServiceName}" Margin="0,3,0,0"  HorizontalAlignment="Stretch" FontSize="14" Grid.Column="1" TextWrapping="1" />
									
									</Grid>
								</DataTemplate>
							</ListBox.ItemTemplate>
						</ListBox>
					</Border>
					
					<TextBlock Margin="0,10,0,0" FontSize="16" Text="Available Service Data Values" Grid.Column="2" VerticalAlignment="Top"/>

					<StackPanel Orientation="Horizontal" Grid.Column="2" HorizontalAlignment="Right">
						<Button  Classes="link" Margin="18,11,0,0"
								Height="24" FontStyle="Italic"
								HorizontalAlignment="Right"
								VerticalContentAlignment="Center"
								Command="{Binding SelectedService.SelectAll}"
								Foreground="SteelBlue" Background="White"
								Content="Select All"/>
						<Button  Classes="link" Margin="0,11,18,0" Grid.Column="2"
							 Height="24" FontStyle="Italic"
							 HorizontalAlignment="Right"
							 VerticalContentAlignment="Center"
							 Command="{Binding SelectedService.UnselectAll}"
							 Foreground="SteelBlue" Background="White"
							 Content="Unselect All"/>
					</StackPanel>
					<Border VerticalAlignment="Stretch" Grid.Row="1" Grid.Column="1" Margin="2,5,20,20" BorderBrush="Gainsboro" BorderThickness="1">
						<ListBox Grid.Column="1" Background="Transparent"
								 ItemsSource="{Binding SelectedService.Keys}"
								 SelectedItem="{Binding SelectedService.SelectedKey}">
							<ListBox.ItemTemplate>
								<DataTemplate>
									<Grid Margin="-5" ColumnDefinitions="30,*,auto" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" >
										<Button  Margin="0,3,0,0" HorizontalAlignment="Left"
												 BorderThickness="0"
												 Width="24"
												 Height="24"
												 VerticalContentAlignment="Center"
												 Command="{Binding IncludeChanged}">
											<Grid>
												<material:MaterialIcon IsVisible="{Binding IsIncluded}" Width="20" Height="20" Foreground="SteelBlue" Kind="CheckboxMarked"></material:MaterialIcon>
												<material:MaterialIcon IsVisible="{Binding !IsIncluded}" Width="20" Height="20" Foreground="Gray" Kind="CheckboxBlank"></material:MaterialIcon>
											</Grid>
										</Button>
										<TextBlock Grid.Column="1" Margin="0,3,0,0" Text="{Binding Key}" HorizontalAlignment="Stretch" FontSize="14"  TextWrapping="1" />
										<TextBlock  IsVisible="{Binding !IsIncluded}" Margin="0,3,0,0" Grid.Column="2" Text="Internal Only" VerticalAlignment="Center" HorizontalAlignment="Stretch" FontSize="14"  TextWrapping="1" />
										<ComboBox IsVisible="{Binding IsIncluded}" Margin="-2,-2,-4,-4" VerticalAlignment="Center" 
												  ItemsSource="{Binding ParentViewModel.ParentViewModel.DataAccessLevels}" Grid.Column="2" 
												 SelectedItem="{Binding DataAccessLevel}" Width="125" />
									</Grid>
								</DataTemplate>
							</ListBox.ItemTemplate>
						</ListBox>
					</Border>
				</Grid>
			</Border>
		</Grid>
	</Grid>
</UserControl>

