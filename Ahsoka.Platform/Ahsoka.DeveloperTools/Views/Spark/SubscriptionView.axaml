<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:CustomerTools="clr-namespace:Ahsoka.DeveloperTools.Views"
			 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="650"  Background="#33555555"
             xmlns:material="using:Material.Icons.Avalonia"
		     xmlns:progRing="clr-namespace:AvaloniaProgressRing;assembly=AvaloniaProgressRing"
             x:Class="Ahsoka.DeveloperTools.Views.SubscriptionView">

	<Border Margin="20" BoxShadow="5 5 10 2 DarkGray" BorderBrush="DarkGray" BorderThickness="1" Background="White">
		<Grid Margin="5" RowDefinitions="Auto,Auto,*" ColumnDefinitions="*">
			<DockPanel Grid.Row="0" Margin="0,5,0,5" >
				<Border DockPanel.Dock="Top" BorderBrush="Gainsboro"  BorderThickness="0,1,0,0" Margin="20,20,40,20" Height="2"/>
			    <TextBlock DockPanel.Dock="Top" Margin="10,-30,0,10" Text="CURRENT SUBSCRIPTION " Foreground="SteelBlue" HorizontalAlignment="Left" Background="White"  />
		
				<Grid ColumnDefinitions="*,Auto">
					<StackPanel Margin="30,0,0,0" VerticalAlignment="Center">
						<TextBlock Margin="8"  Text="{Binding Subscription.SubscriptionTier.TierName, StringFormat='Subscription Tier: {0}', FallbackValue='Subscription: None'}"
													   FontSize="14"  HorizontalAlignment="Left" Foreground="Gray" />						
						<TextBlock Margin="8" Text="{Binding Subscription.ExpirationDate, StringFormat='Expiration: {0}',FallbackValue='Expires: None'}"
													   FontSize="14"  HorizontalAlignment="Left" Foreground="Gray" />
						<TextBlock Margin="8" Text="{Binding Subscription.AutoRenew, StringFormat='Renewing: {0}',FallbackValue='Renewing: true'}"
													   FontSize="14"  HorizontalAlignment="Left" Foreground="Gray" />
						<StackPanel Margin="8" Orientation="Horizontal" HorizontalAlignment="Left" >
							<TextBlock  Text="{Binding Subscription.SubscriptionStatus, StringFormat='Status: {0}',FallbackValue='Status: Active'}"
													   FontSize="14"  HorizontalAlignment="Left" Foreground="Gray" />

							<Button Command="{Binding Subscription.ViewHistory}" Margin="10,-4,3,0" ToolTip.Tip="View History"
								 Width="26" Height="26" Background="Transparent"  BorderBrush="Transparent">
								<material:MaterialIcon Width="20" Height="20" Foreground="SteelBlue" Kind="Table"></material:MaterialIcon>
							</Button>
						</StackPanel>
					</StackPanel>
					
					<Border Margin="0,-5,45,0"  BoxShadow="2 3 6 2 DarkGray"
							Grid.Column="1" BorderBrush="Gray" 
							BorderThickness="1" Background="WhiteSmoke" Padding="15">
						<StackPanel>
							<Border Background="Gray" Margin="-15,-15,-15,0" Height="25">
								<TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Text="Current Subscription Limits"
									    Foreground="White" FontWeight="Light" />
							</Border>
							
							<TextBlock Margin="12,10,12,8" FontSize="12" HorizontalAlignment="Center" Text="{Binding Subscription.MemberText, FallbackValue='Users: Fetching'}"
									  Foreground="Gray"/>
							<ProgressBar  BorderBrush="Gray" BorderThickness="1" Padding="2" CornerRadius="0" Minimum="0" Foreground="{Binding Subscription.UserBarColor, FallbackValue=Gray}"
										 Maximum="1"
										 Value="{Binding PercentMembers, FallbackValue=0.5}"
										 Height="11" Width="225" MaxWidth="225" MinWidth="225"/>

							<TextBlock Margin="12,10,12,8" FontSize="12" HorizontalAlignment="Center" Text="{Binding  Subscription.DeviceText, FallbackValue='Devices: Fetching'}"
									   Foreground="Gray"/>
							<ProgressBar BorderBrush="Gray" BorderThickness="1" Padding="2" CornerRadius="0" Minimum="0" Foreground="{Binding Subscription.DeviceBarColor, FallbackValue=Gray}"
										 Maximum="1"
										 Value="{Binding Subscription.PercentDevices, FallbackValue=0.5}"
										 Height="11" Width="225" MaxWidth="225" MinWidth="225"/>
						</StackPanel>
					</Border>
				</Grid>
			</DockPanel>

			<Border Grid.Row="1" BorderBrush="Gainsboro"  BorderThickness="0,1,0,0" Margin="20,20,20,0" Height="2"/>
			<TextBlock Grid.Row="1"  Margin="10,17,0,0" Text="CHANGE SUBSCRIPTION " Foreground="SteelBlue" HorizontalAlignment="Left" Background="White"  />
				
			<Grid Grid.Row="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"  Margin="0,5,0,5" >
				
				<ScrollViewer Padding="20,5" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
					<ItemsRepeater VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
								   ItemsSource="{Binding Subscription.SubscriptionTiers}">
						<ItemsRepeater.Layout>
							<StackLayout Spacing="0" Orientation="Vertical"/>
						</ItemsRepeater.Layout>
						<ItemsRepeater.ItemTemplate>
							<DataTemplate>
								<CustomerTools:SparkSubscriptionSelectionView/>
							</DataTemplate>
						</ItemsRepeater.ItemTemplate>
					</ItemsRepeater>
				</ScrollViewer>
			</Grid>
			
			<Button Margin="2" Grid.Column="1" Width="24" Height="24"
				HorizontalAlignment="Right"
				VerticalAlignment="Top"
				Command="{Binding Back}"
				Background="Transparent">
				<material:MaterialIcon Padding="5"  Background="Transparent"
									   Foreground="SteelBlue" Kind="Close"/>
			</Button>
		</Grid>

	</Border>
</UserControl>
