<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<UserSecretsId>5861d827-1f17-41c9-9344-c2616ea52eb6</UserSecretsId>
	</PropertyGroup>

	<!--Disable Build Outputs-->
	<Target Name="Build" />
	<Target Name="Rebuild" />

	<PropertyGroup>
		<SecretPath>$(appdata)\Microsoft\UserSecrets\$(UserSecretsId)\secrets.json</SecretPath>
		<OpenViewBSP>3.2024-08-07T132301.openview.kirkstone.91e8420</OpenViewBSP>
		<OpenViewProBSP>3.2024-08-06T110843.openviewpro.kirkstone.6d309b5</OpenViewProBSP>
		<Download_Root>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)..\..\..\'))</Download_Root>
	</PropertyGroup>

	<Target Name="Clean BuildOutputs" BeforeTargets="BeforeClean">
		<Message Text="Cleaning Downloads" Importance="high" />
		<RemoveDir Directories="$(Download_Root)FirmwareDownload" />
	</Target>

	<Target Name="DownloadBSPs" AfterTargets="PostBuildEvent" >
		<!--This section Downloads the BSP to be included in the OpenView Package the Version used is specfied in the OpenViewBSP Property Above.
		Note that this requires that you have the SparkLogin and SparkPassword stored in your local Secrets file...same values used for tests.-->

		<JsonPeek ContentPath="$(SecretPath)" Query=".SparkLogin">
			<Output TaskParameter="Result" ItemName="SparkLogin" />
		</JsonPeek>
		<JsonPeek ContentPath="$(SecretPath)" Query=".SparkPassword">
			<Output TaskParameter="Result" ItemName="SparkPassword" />
		</JsonPeek>
		<PropertyGroup>
			<SparkLogin>@(SparkLogin)</SparkLogin>
			<SparkPassword>@(SparkPassword)</SparkPassword>
		</PropertyGroup>

		<Message Text="$(Download_Root)FirmwareDownload\OpenViewLinux_TargetSupport\Firmware\image.$(OpenViewBSP).zip" Importance="high" />

		<Exec Command="dotnet tool update --global  EnovationCloud.CommandLine" />
	</Target>
	
	<Target Name="DownloadOpenView" AfterTargets="DownloadBSPs" Condition="!Exists('$(Download_Root)FirmwareDownload\OpenViewLinux_TargetSupport\Firmware\image.$(OpenViewBSP).zip')">
		<Copy SourceFiles="OpenView.upgradeinfo.json" DestinationFiles="$(Download_Root)FirmwareDownload\OpenViewLinux_TargetSupport\Firmware\OpenView.upgradeinfo.json" />
		<Exec WorkingDirectory="$(Download_Root)" Command="EnovationCloud.CommandLine --DownloadFromSpark  sparkserviceprod.azurewebsites.net $(SparkLogin) &quot;$(SparkPassword)&quot; &quot;$(Download_Root)FirmwareDownload\OpenViewLinux_TargetSupport\Firmware&quot; &quot;OpenPV Distribution Upgrade&quot; $(OpenViewBSP) upgrade.$(OpenViewBSP).zip" />
		<Exec WorkingDirectory="$(Download_Root)" Command="EnovationCloud.CommandLine --DownloadFromSpark  sparkserviceprod.azurewebsites.net $(SparkLogin) &quot;$(SparkPassword)&quot; &quot;$(Download_Root)FirmwareDownload\OpenViewLinux_TargetSupport\Firmware&quot; &quot;OpenPV Distribution&quot; $(OpenViewBSP) image.$(OpenViewBSP).zip" />
	</Target>
	
	<Target Name="DownloadOpenViewPro" AfterTargets="DownloadBSPs" Condition="!Exists('$(Download_Root)FirmwareDownload\OpenViewLinuxPro_TargetSupport\Firmware\image.$(OpenViewProBSP).zip')">
		<Exec WorkingDirectory="$(Download_Root)" Command="EnovationCloud.CommandLine --DownloadFromSpark  sparkserviceprod.azurewebsites.net $(SparkLogin) &quot;$(SparkPassword)&quot; &quot;$(Download_Root)FirmwareDownload\OpenViewLinuxPro_TargetSupport\Firmware&quot; &quot;OpenPV Distribution&quot; $(OpenViewProBSP) image.$(OpenViewProBSP).zip" />
	</Target>

	<ItemGroup>
		<PackageReference Include="JsonPeek" Version="1.2.0" />
		<PackageReference Include="GitVersion.MsBuild" Version="5.12.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="8.0.0" />
	</ItemGroup>

</Project>
