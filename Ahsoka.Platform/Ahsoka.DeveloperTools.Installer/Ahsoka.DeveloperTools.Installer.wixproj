<Project Sdk="WixToolset.Sdk/4.0.1">
  <PropertyGroup>
    <TargetFramework>net7.0</TargetFramework>
    <OutputName>OpenPV.Installer</OutputName>
    <Name>Ahsoka.OpenPV.Installer</Name>
    <UpdateAssemblyInfo>false</UpdateAssemblyInfo>
    <GenerateGitVersionInformation>false</GenerateGitVersionInformation>
    <SuppressIces>ICE60;ICE61</SuppressIces>
    <OutputPath>..\SparkUpload\</OutputPath>
    <DebugType>Full</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.Util.wixext" Version="4.0.5" />
    <PackageReference Include="WixToolset.UI.wixext" Version="4.0.5" />
    <PackageReference Include="WixToolset.NetFx.wixext" Version="4.0.5" />
    <PackageReference Include="WixToolset.Heat" Version="4.0.5" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="FilterEXE.xslt" />
    <Content Include="OpenPV-Icon.ico" />
  </ItemGroup>
  <PropertyGroup>
    <LinkerBaseInputPaths>..\PlatformSupport\Ahsoka.Tools\Windows64</LinkerBaseInputPaths>
    <DefineConstants>BasePath=..\PlatformSupport\Ahsoka.Tools\Windows64</DefineConstants>
  </PropertyGroup>
  <Target Name="CustomBeforeBuild" BeforeTargets="BeforeBuild">
    <Message Text="RUN HEAT  $(WixHeatTasksPath)" Importance="high" />
    <Exec Command="dotnet publish ..\Ahsoka.DeveloperTools\Ahsoka.DeveloperTools.csproj -p:PublishProfile=WindowsOutputs" />
    <HeatDirectory OutputFile="obj\Components.wxs" DirectoryRefId="INSTALLDIR" ComponentGroupName="OpenPVOutputs" SuppressCom="true" Directory="..\PlatformSupport\Ahsoka.Tools\Windows64" SuppressFragments="true" SuppressRegistry="true" SuppressRootDirectory="true" AutoGenerateGuids="false" GenerateGuidsNow="true" ToolPath="$(WixToolPath)" PreprocessorVariable="var.BasePath" Transforms="FilterEXE.xslt" />
    <ItemGroup>
      <Compile Include="obj\Components.wxs" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <PackageReference Include="GitVersion.MsBuild" Version="5.12.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>