<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      		 xmlns:CustomerTools="clr-namespace:Ahsoka.DeveloperTools.Views"
             mc:Ignorable="d" d:DesignWidth="1024" d:DesignHeight="800"
             xmlns:material="using:Material.Icons.Avalonia"
		     x:Class="Ahsoka.DeveloperTools.Views.PackageEditor">
	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*"/>
			<ColumnDefinition Width="250"/>
		</Grid.ColumnDefinitions>
		<Border BorderBrush="Gainsboro" BorderThickness="1,0,0,0" Grid.Row="0"
				Grid.Column="1" Grid.RowSpan="2"  Background="WhiteSmoke" VerticalAlignment="Stretch" Margin="0,0,0,0">
			
		</Border>

		<TabControl SelectedIndex="{Binding SelectedPackage.SelectedTab}"
					VerticalAlignment="Stretch" Grid.Column="0" 
					Grid.ColumnSpan="2" Grid.Row="0" Grid.RowSpan="2" 
					HorizontalAlignment="Stretch" Padding="0,-10" TabStripPlacement="Top" >
			<TabItem>
				<TabItem.Header>
					<TextBlock FontSize="18"
							   Text="Packaging"/>
				</TabItem.Header>
				<CustomerTools:PackageInfoView/>
			</TabItem>
			<TabItem>
				<TabItem.Header>
					<TextBlock
						FontSize="18"
						Text="Development"/>
				</TabItem.Header>
				<CustomerTools:DeveloperView/>
			</TabItem>
			<TabItem IsVisible="{Binding SelectedPackage.HasScreen}">
				<TabItem.Header>
					<TextBlock
						FontSize="18"
						Text="Display"/>
				</TabItem.Header>
				<CustomerTools:DisplayView/>
			</TabItem>
			<TabItem >
				<TabItem.Header>
					<TextBlock
						FontSize="18"
						Text="Hardware"/>
				</TabItem.Header>
				<CustomerTools:HardwareConfigView/>
			</TabItem>
			<TabItem IsVisible="{Binding SelectedPackage.IsOpenView}" >
				<TabItem.Header>
					<TextBlock
						FontSize="18"
						Text="Extensions"/>
				</TabItem.Header>
				<CustomerTools:ExtensionsView/>
			</TabItem>
			<TabItem IsVisible="{Binding SelectedPackage.IsOpenView}" >
				<TabItem.Header>
					<TextBlock
						FontSize="18"
						Text="Startup"/>
				</TabItem.Header>
				<CustomerTools:StartupOptionsView/>
			</TabItem>
			
			<TabItem IsVisible="{Binding SelectedPackage.IsOpenView}" >
				<TabItem.Header>
					<TextBlock
						FontSize="18"
						Text="Services"/>
				</TabItem.Header>
				<CustomerTools:ServiceOptionsView/>
			</TabItem>
		
		</TabControl>

		<CustomerTools:DependenciesView Grid.Column="0" 
			Grid.ColumnSpan="3" 
			DataContext="{Binding SelectedPackage.Deps}"/>

		
	</Grid>
</UserControl>

