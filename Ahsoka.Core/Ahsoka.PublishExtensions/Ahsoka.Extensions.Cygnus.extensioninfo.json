{
  "extensionName": "Cygnus Reach Service Extension",
  "packageName": "Ahsoka.Extensions.CygnusReach",
  "uxpackageName": "Ahsoka.Extensions.CygnusReach.UX.Desktop",
  "uxViewModelName": "CygnusReachSetupViewModel",
  "serviceConfigurations": [
    {
      "socketType": "TcpSocket",
