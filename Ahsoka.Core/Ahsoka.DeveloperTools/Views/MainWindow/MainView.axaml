<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:CustomerTools="clr-namespace:Ahsoka.DeveloperTools.Views"
             xmlns:material="using:Material.Icons.Avalonia"
			 mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="450"
   		 x:Class="Ahsoka.DeveloperTools.Views.MainView">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="55"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="40"/>
		</Grid.RowDefinitions>

		<CustomerTools:ToolBar IsEnabled="{Binding !ProgressVisible}" />

		<CustomerTools:PackageEditor  Grid.Row="1" IsVisible="{Binding SelectedPackage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"  />

		<ContentControl DataContext="{Binding Popup}" Grid.Row="1" Content="{Binding PopupUserControl}"/>

		<Grid Grid.Row="1" DataContext="{Binding Console}" 
			  IsVisible="{Binding ConsoleVisible}" 
			  Background="#33555555">
			<Grid.Styles>
				<Style Selector="Border">
					<Setter Property="Opacity" Value="0"/>
				</Style>
				<Style Selector="Border[IsVisible=true]">
					<Setter Property="Opacity" Value="1"/>
				</Style>
			</Grid.Styles>
			<Grid.Transitions>
				<Transitions>
					<DoubleTransition Property="Opacity" Duration="0:0:5"/>
				</Transitions>
			</Grid.Transitions>
			<Border Margin="0,0,100,0" BoxShadow="5 5 10 2 DarkGray" BorderBrush="DarkGray" BorderThickness="0,0,1,0" HorizontalAlignment="Stretch"  Background="White">
				<CustomerTools:ConsoleView   />
			</Border>
		</Grid>

		<Grid Grid.Row="1" DataContext="{Binding Updates}"
		      IsVisible="{Binding UpdatesVisible}" 
			  Opacity="{Binding UpdatesOpacity}"
			  Background="#33555555">
			<Grid.Transitions>
				<Transitions>
					<DoubleTransition Property="Opacity" Duration="0:0:0.5"/>
				</Transitions>
			</Grid.Transitions>
			<Border BoxShadow="10 10 10 2 DarkGray" BorderBrush="DarkGray" BorderThickness="1,0,0,0" HorizontalAlignment="Right"  Background="Transparent">
				<CustomerTools:UpdatesView/>
			</Border>
		</Grid>
		
		<CustomerTools:StatusBar Grid.Row="2"  IsVisible="{Binding !ProgressVisible,FallbackValue=true}" />

		<Grid IsVisible="{Binding ProgressVisible,FallbackValue=true}" Grid.Row="4" >
			<Border BorderBrush="Gainsboro" Background="WhiteSmoke" BorderThickness="0,0,0,1" Margin="1,0,0,0" >
				<DockPanel LastChildFill="False">
					<TextBlock Foreground="SteelBlue" FontSize="16" Padding="10" Text="{Binding StatusText}"/>
					<Button DockPanel.Dock="Right" Content="Cancel" Command="{Binding Cancel}">
						<StackPanel Orientation="Horizontal">
							<material:MaterialIcon Width="18" Height="18" Foreground="SteelBlue" Kind="Cancel"></material:MaterialIcon>
							<TextBlock Margin="4,0" VerticalAlignment="Center" FontSize="13"  Text="Cancel"/>
						</StackPanel>
					</Button>
				</DockPanel>
			</Border>
			<ProgressBar MinHeight="1" Height="1" BorderThickness="0"  CornerRadius="0"
				 VerticalAlignment="Top" IsIndeterminate="True" IsEnabled="True" />
		</Grid>
		
		<Grid Row="1"  Background="#33555555" DataContext="{Binding Dialog}"  IsVisible="{Binding DialogVisible, FallbackValue=True}">
			<Border Padding="30" BoxShadow="5 5 10 2 DarkGray" BorderBrush="SteelBlue" VerticalAlignment="Center"  Width="650"  Grid.RowSpan="2" Background="White" BorderThickness="1,1">
				<DockPanel LastChildFill="False">
					<TextBlock FontWeight="Bold" DockPanel.Dock="Top" Foreground="SteelBlue" TextWrapping="Wrap" FontSize="16" Padding="10" Text="{Binding DialogTitle, FallbackValue='TitleText'}"></TextBlock>
					<ScrollViewer Margin="0,0,0,15" DockPanel.Dock="Top" MaxHeight="450">
						<TextBlock  Foreground="SteelBlue" TextWrapping="Wrap" FontSize="16" Padding="10" Text="{Binding DialogText, FallbackValue='Text'}"></TextBlock>
					</ScrollViewer>
					<DockPanel MinHeight="30" DockPanel.Dock="Bottom" HorizontalAlignment="Right">
						<Button IsDefault="True"  Content="{Binding DialogAcceptText}" Padding="15,8" Command="{Binding AcceptMessage}"/>
						<Button IsCancel="True"  Content="{Binding DialogRejectText}"  Padding="15,8" Command="{Binding CancelMessage}" IsVisible="{Binding ShowReject}"/>
					</DockPanel>
				</DockPanel>
			</Border>
		</Grid>

		<Border Grid.Row="1"  IsVisible="{Binding Downloads.DownloadInProgress}" 
				Grid.ColumnSpan="2" BorderBrush="DarkGray" Background="#44888888" BorderThickness="0,0,0,0" Margin="0,0,0,0" >
			<Border  BoxShadow="5 5 10 2 DarkGray" Height="120" Width="600" Grid.ColumnSpan="2" BorderBrush="DarkGray" Background="White" BorderThickness="1">
				<Grid VerticalAlignment="Center">
					<TextBlock Foreground="SteelBlue" FontSize="16"
							   VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,45"
							   Padding="10" Text="{Binding Downloads.PercentStatus, FallbackValue=Downloading...}"/>

					<ProgressBar MinHeight="1" Height="5" Width="450"
								 BorderThickness="0"  CornerRadius="0" VerticalAlignment="Center" HorizontalAlignment="Center" Value="{Binding Downloads.DownloadPercent}"
								 Minimum="0" Maximum="100"
								 IsEnabled="True" />

					<Button Grid.Column="2" Grid.Row="0"
								HorizontalAlignment="Center" Padding="10,5"
								VerticalAlignment="Center" Margin="0,55,0,0"
								Command="{Binding Downloads.Cancel}" FontSize="10"
								Background="Transparent" Content="Cancel"/>
				</Grid>
			</Border>
		</Border>


	</Grid>
</UserControl>