<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<!--Disable Build Outputs-->
	<Target Name="Build" />
	<Target Name="Rebuild" />

	<PropertyGroup>
		<ExtensionRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)..\..\..\'))</ExtensionRoot>
	</PropertyGroup>

	<Target Name="Clean BuildOutputs" BeforeTargets="BeforeClean">
		<Message Text="Cleaning BuildExtension BuildOutputs" Importance="high" />
		<Delete Files="$(ExtensionRoot)\SparkUpload\OpenPV Extensions.zip" />
	</Target>

	<Target Name="CreateExtensions" AfterTargets="PostBuildEvent">
		<Message Text="Build with Extension Root $(ExtensionRoot)" Importance="high" />

		<!-- Create Extension Package Info.  System will use these nuget packages to download the libraries-->
		<ItemGroup>
			<EXTENSION_INFO Include="$(ExtensionRoot)Ahsoka.Core\Ahsoka.PublishExtensions\*.extensioninfo.json" />
		</ItemGroup>

		<Copy SourceFiles="@(EXTENSION_INFO)" DestinationFolder="$(ExtensionRoot)\SparkUpload\ExtensionInfo" />

		<ZipDirectory Overwrite="true" SourceDirectory="$(ExtensionRoot)\SparkUpload\ExtensionInfo\" DestinationFile="$(ExtensionRoot)\SparkUpload\OpenPV Extensions.zip" />

		<!--Copy Spark Package Manifst to Output -->
		<Copy SourceFiles="OpenPV Extensions.release.json" DestinationFiles="$(ExtensionRoot)\SparkUpload\OpenPV Extensions.release.json" />
	</Target>

	<ItemGroup>
		<PackageReference Include="GitVersion.MsBuild" Version="[5.12.0]">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

</Project>
