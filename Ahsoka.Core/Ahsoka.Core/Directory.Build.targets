<Project>
	
	<!--Note that this will only run once.  To generate licenses again, you must delete the file.-->
	<Target Name="GenerateLicenseFile" BeforeTargets="PreBuildEvent"
			Condition="!Exists('..\Ahsoka.Core\Resources\Licenses.json') ">
		
		<Message Text="Generate License File" Importance="High" />
		<Exec ContinueOnError="true" Command="dotnet tool update --global dotnet-project-licenses --version 2.7.*" />
		<Exec Command="dotnet project-licenses -i . -o --outfile ../Ahsoka.Core/Resources/Licenses.json -j -p false" />
	</Target>
	
	<ItemGroup Label="Native Libraries For Core" Condition="$(IGNORE_PREREQS) != 'YES' and '$(OS)' != 'Unix'">
		<Content Include="..\..\BuildOutputs\Platform\OpenViewLinux\Ahsoka.Wifi.OpenViewLinux.so">
			<Link>AhsokaLib\Ahsoka.Wifi.OpenViewLinux.so</Link>
			<PackagePath>contentFiles/any/any/AhsokaLib/Ahsoka.Wifi.OpenViewLinux.so</PackagePath>
			<PackageCopyToOutput>true</PackageCopyToOutput>
			<IncludeInPackage>true</IncludeInPackage>
			<Pack>true</Pack>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Visible>true</Visible>
		</Content>
	</ItemGroup>
</Project>