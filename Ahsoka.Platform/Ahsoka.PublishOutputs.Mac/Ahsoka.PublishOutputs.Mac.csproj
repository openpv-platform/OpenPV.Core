<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
	</PropertyGroup>

	<PropertyGroup>
		<BuildDir>$(ProjectDir)../../</BuildDir>
	</PropertyGroup>

	<Target Name="Clean Platform Support Folders" BeforeTargets="BeforeClean">
		<Message Text="Clean Platform Support Folders" Importance="high" />
		<RemoveDir Directories="$(BuildDir)PlatformSupport/" />
		<RemoveDir Directories="$(BuildDir)SparkUpload/" />
		<MakeDir Directories="$(BuildDir)PlatformSupport/" />
		<MakeDir Directories="$(BuildDir)SparkUpload/" />
	</Target>

	<Target Name="CreateMacOSPublishOutputs" AfterTargets="PostBuildEvent" Condition="!Exists('$(BuildDir)\SparkUpload\MacOSARM64_TargetSupport.zip') AND '$(OS)' == 'Unix'">

		<Message Condition="false" Text="Install License Generator" Importance="High" />
		<Exec Condition="false" ContinueOnError="true" Command="dotnet tool uninstall --global dotnet-project-licenses" />
		<Exec ContinueOnError="true" Command="dotnet tool install --global dotnet-project-licenses --version 2.7.1" />

		<Exec Command="dotnet msbuild ../Ahsoka.DeveloperTools/Ahsoka.DeveloperTools.csproj --t:BundleApp  -p:UseAppHost=true -p:TargetFramework=net8.0 -p:RuntimeIdentifier=osx-arm64" />

		<ItemGroup>
			<MacTools Include="$(BuildDir)Ahsoka.Platform/Ahsoka.DeveloperTools/bin/Debug/net8.0/osx-arm64/publish/OpenPV.DeveloperToolkit.app/**/*" />
			<MacTools Remove="$(BuildDir)Ahsoka.Platform/Ahsoka.DeveloperTools/bin/Debug/net8.0/osx-arm64/publish/OpenPV.DeveloperToolkit.app/Contents/MacOS/runtimes/linux*/**/*" />
			<MacTools Remove="$(BuildDir)Ahsoka.Platform/Ahsoka.DeveloperTools/bin/Debug/net8.0/osx-arm64/publish/OpenPV.DeveloperToolkit.app/Contents/MacOS/runtimes/win*/**/*" />
			<MacTools Remove="$(BuildDir)Ahsoka.Platform/Ahsoka.DeveloperTools/bin/Debug/net8.0/osx-arm64/publish/OpenPV.DeveloperToolkit.app/Contents/MacOS/runtimes/unix*/**/*" />
		</ItemGroup>

		<MakeDir ContinueOnError="true" Directories="$(BuildDir)SparkUpload/" />
		<Copy SourceFiles="@(MacTools)" DestinationFolder="$(BuildDir)PlatformSupport/Ahsoka.Tools/MacOS/OpenPV.DeveloperToolkit.app/%(RecursiveDir)" />
		<Copy SourceFiles="../Ahsoka.DeveloperTools/Assets/OpenPV.icns" DestinationFiles="$(BuildDir)PlatformSupport/Ahsoka.Tools/MacOS/OpenPV.DeveloperToolkit.app/Contents/Resources/OpenPV.icns" />

		<Exec IgnoreExitCode="true" Command="chmod +x $(BuildDir)/Ahsoka.Platform/SignApp.sh" />
		<Exec IgnoreExitCode="true" Command="$(BuildDir)/Ahsoka.Platform/SignApp.sh" />

		<!--Create Zip File Compatible with NotoryTools -->
		<Exec Command="ditto -c -k --sequesterRsrc --keepParent $(BuildDir)PlatformSupport/Ahsoka.Tools/MacOS/OpenPV.DeveloperToolkit.app $(BuildDir)PlatformSupport/Ahsoka.Tools/MacOS/MacOS.DeveloperToolkit.zip" />

		<Copy SourceFiles="OpenPV for MacOS.release.json" DestinationFiles="$(BuildDir)SparkUpload/OpenPV for MacOS.release.json" />

		<Exec Command="dotnet publish ../Ahsoka.CommandLine/Ahsoka.CommandLine.csproj -p:PublishProfile=MacOSOutputs" />
		<Exec Command="chmod +x $(BuildDir)PlatformSupport/MacOSARM64_TargetSupport/CommandLine/Ahsoka.CommandLine" />
		<WriteLinesToFile File="$(BuildDir)/PlatformSupport/MacOSARM64_TargetSupport/MacOSARM64_TargetSupport.zip.customertools.version" Lines="$(GitVersion_SemVer)" Overwrite="true" Encoding="UTF-8" />

		<Exec IgnoreExitCode="true" Command="chmod +x $(BuildDir)/Ahsoka.Platform/SignCLI.sh" />
		<Exec IgnoreExitCode="true" Command="$(BuildDir)/Ahsoka.PlatformSignCLI.sh" />

		<!--Create Zip File Compatible with NotoryTools - NOTE We notorize this one in place since we have no need to staple-->
		<Exec Command="ditto -c -k --sequesterRsrc $(BuildDir)/PlatformSupport/MacOSARM64_TargetSupport/ $(BuildDir)/SparkUpload/MacOSARM64_TargetSupport.zip" />

	</Target>
</Project>

