<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
	
	<?define ProductVersion=!(bind.fileVersion.ExecutableId) ?>
	<?define IconVersion="!(bind.property.ProductVersion.Major).!(bind.property.ProductVersion.Minor)" ?>

	<Package Name="OpenPV $(var.ProductVersion)" 
			 Language="1033" 
			 Version="$(var.ProductVersion)"
			 Manufacturer="Enovation Controls" 
			 UpgradeCode="adb2a200-46dd-4c69-b139-308002b00352" 
			 InstallerVersion="200">

		<MajorUpgrade AllowDowngrades="yes" />

		<MediaTemplate EmbedCab="yes" />

		<Feature Id="ProductFeature" Title="Ahsoka.OpenPV.Installer" Level="1">
			<ComponentGroupRef Id="OpenPVOutputs" />
		</Feature>

		<!--The INSTALLDIR property makes sure that the install directory can be changed at install-time.
        Marking a property as Secure will allow it to pass from the client-side to the server-side during the Execute sequence, which is where the magic happens-->
		<Property Id="INSTALLDIR" Secure="yes" />

		<!--This ties INSTALLDIR to the WiX UI-->
		<Property Id="WIXUI_INSTALLDIR" Value="INSTALLDIR" Secure="yes"  />

		<!--This sets the icon in add/remove programs-->
		<Property Id="ARPPRODUCTICON" Value="OpenPV-Icon.ico" />
		<Property Id="MSIINSTALLPERUSER" Value="1" />
		<Property Id="DISABLEADVTSHORTCUTS" Value="1" />
		<Property Id="UPDATING_AUTOMATICALLY" Value="0" Secure="yes" />

		<CustomAction Id="LaunchApplication" ExeCommand="" Execute="immediate" Impersonate="yes" Return="asyncNoWait" FileRef="ExecutableId" />

		<InstallExecuteSequence>
			<Custom Action="LaunchApplication" After="InstallFinalize" Condition="UPDATING_AUTOMATICALLY=1" />
		</InstallExecuteSequence>
	</Package>

	<Fragment>
			<StandardDirectory Id="ProgramFilesFolder">
				<Directory Id="INSTALLDIR" Name="Ahsoka.OpenPV.Installer" />
			</StandardDirectory>

			<StandardDirectory Id="DesktopFolder" />

			<StandardDirectory Id="ProgramMenuFolder" />
		</Fragment>

	<Fragment>
		<ComponentGroup Id="ProductComponents" Directory="INSTALLDIR">
			<!-- TODO: Remove the comments around this Component element and the ComponentRef below in order to add resources to this installer. -->
			<!-- <Component Id="ProductComponent"> -->
			<!-- TODO: Insert files, registry keys, and other resources here. -->
			<!-- </Component> -->
		</ComponentGroup>
	</Fragment>

	<Fragment>
		<Icon Id="OpenPVIcon.ico" SourceFile="$(var.BasePath)\Assets\OpenPV-Icon.ico"  />

		<DirectoryRef Id="INSTALLDIR">
			<Component Id="cmpSQQlXk5DtaTE9_sUKgAsEbkw6Zg" Guid="3E4D4C89-EB4C-4B0C-88C0-7B9A239FD342">

				<File Id="ExecutableId" DiskId="1" Source="$(var.BasePath)\OpenPV.DeveloperToolkit.exe" KeyPath="yes">

					<Shortcut Id="ProgramDirShortcutId"
							  Directory="ProgramMenuFolder" 
							  Name="OpenPV $(var.IconVersion)"
							  WorkingDirectory="INSTALLDIR" 
							  Icon="OpenPVIcon.ico" 
							  Advertise="yes" />

					<Shortcut Id="DesktopShortcutId"
							  Directory="DesktopFolder" 
							  Name="OpenPV $(var.IconVersion)" 
							  WorkingDirectory="INSTALLDIR" 
							  Icon="OpenPVIcon.ico"
							  IconIndex="0" 
							  Advertise="yes" />
				</File>
			</Component>
		</DirectoryRef>
	</Fragment>
</Wix>
