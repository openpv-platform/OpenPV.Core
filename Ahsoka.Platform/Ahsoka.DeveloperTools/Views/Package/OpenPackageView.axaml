<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="400"
			 xmlns:material="using:Material.Icons.Avalonia"
			 xmlns:CustomerTools="clr-namespace:Ahsoka.DeveloperTools.Views"
             x:Class="Ahsoka.DeveloperTools.Views.OpenPackageView" Background="#33555555">
	<Border Margin="60" BoxShadow="5 5 10 2 DarkGray" BorderBrush="DarkGray" BorderThickness="1" Background="White">
		<Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
			<Grid.RowDefinitions>
				<RowDefinition Height="*"/>
				<RowDefinition Height="60"/>
			</Grid.RowDefinitions>
			<Border BorderBrush="Gainsboro" BorderThickness="0,1,0,0"
					Grid.Row="1" Grid.Column="0" Grid.RowSpan="2"  Background="WhiteSmoke" VerticalAlignment="Stretch" Margin="0,0,0,0">

			</Border>
			<DockPanel  Grid.RowSpan="2" 
					   HorizontalAlignment="Stretch" 
					   VerticalAlignment="Stretch" LastChildFill="True">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="*"/>
						<RowDefinition Height="60"/>
					</Grid.RowDefinitions>

					<Grid Grid.Row="1"
							   VerticalAlignment="Stretch"
							   HorizontalAlignment="Stretch">
						<Button HorizontalAlignment="Right"
								Height="38"
								Margin="10,0"
						 	 VerticalContentAlignment="Center"
								Command="{Binding OpenExisting}" >
							<StackPanel Orientation="Horizontal">
								<material:MaterialIcon Width="24" Height="24" Foreground="SteelBlue" Kind="FolderOutline"></material:MaterialIcon>
								<TextBlock Margin="6,0" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="13"  Text="Open Package Info"/>
							</StackPanel>
						</Button>
						<Button HorizontalAlignment="Left"
							Height="38"
							Margin="10,0"
							VerticalContentAlignment="Center"
							Command="{Binding BrowsePackage}" >
							<StackPanel Orientation="Horizontal">
								<material:MaterialIcon Width="24" Height="24" Foreground="SteelBlue" Kind="Search"></material:MaterialIcon>
								<TextBlock Margin="6,0" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="13"  Text="Browse..."/>
							</StackPanel>
						</Button>
					</Grid>

					<Grid VerticalAlignment="Stretch"  Margin="15" Grid.Row="0" 
						  RowDefinitions="24,*">
						<TextBlock FontSize="22" Grid.Row="0" Text="Recent Packages"/>
						<Border Grid.Row="1" Margin="5" Padding="3" BorderBrush="WhiteSmoke" BorderThickness="0,0,0,0">
							<DataGrid Name="FileList"  SelectedItem="{Binding SelectedProject}"
									  BorderThickness="0" Margin="0,10,0,0" SelectionMode="Single"
									  GridLinesVisibility="None"  ScrollViewer.VerticalScrollBarVisibility="Auto"
									  IsReadOnly="True" CanUserResizeColumns="True"
									  ItemsSource="{Binding RecentItems}" AutoGenerateColumns="False">
								<DataGrid.Columns>
									<DataGridTemplateColumn CanUserResize="False">
										<DataGridTemplateColumn.CellTemplate>
											<DataTemplate>
												<Grid>
													<material:MaterialIcon ToolTip.Tip="Favorite Item" IsVisible="{Binding IsFavorite}" Width="20" Height="20" Foreground="SteelBlue" Kind="Star"></material:MaterialIcon>
													<material:MaterialIcon ToolTip.Tip="Favorite Item" IsVisible="{Binding !IsFavorite}" Width="20" Height="20" Foreground="Silver" Kind="StarOutline"></material:MaterialIcon>
												</Grid>
											</DataTemplate>
										</DataGridTemplateColumn.CellTemplate>
									</DataGridTemplateColumn>
									<DataGridTextColumn FontSize="12" Header="Name" MinWidth="200" Binding="{Binding Name}" />
									<DataGridTextColumn FontSize="12" Header="Description" MinWidth="200"  Binding="{Binding Description}" />
									<DataGridTextColumn FontSize="12"  Header="Location" Width="*"  Binding="{Binding FilePath}" />
									<DataGridTemplateColumn CanUserResize="False">
										<DataGridTemplateColumn.CellTemplate>
											<DataTemplate>
												<material:MaterialIcon ToolTip.Tip="Remove Recent Item" Width="16" Height="16" Foreground="Silver" Kind="MinusCircle"></material:MaterialIcon>
											</DataTemplate>
										</DataGridTemplateColumn.CellTemplate>
									</DataGridTemplateColumn>
								</DataGrid.Columns>
							</DataGrid>
						</Border>
					</Grid>
				</Grid>
			</DockPanel>

			<Button Margin="4" Grid.Row="0" Width="24" Height="24"
					HorizontalAlignment="Right"
					VerticalAlignment="Top"
					Command="{Binding OpenPackage}"
					Background="Transparent">
				<material:MaterialIcon Padding="5"  Background="Transparent"
									   Foreground="SteelBlue" Kind="Close"/>
			</Button>
		</Grid>
	</Border>
</UserControl>
