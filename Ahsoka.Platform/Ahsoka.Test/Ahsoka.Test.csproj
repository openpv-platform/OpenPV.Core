<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<IsPackable>false</IsPackable>
		<PlatformTarget>AnyCPU</PlatformTarget>
		<UserSecretsId>5861d827-1f17-41c9-9344-c2616ea52eb6</UserSecretsId>
		<NoWarn>CS0618</NoWarn> <!--For Spark-->
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
		<PlatformTarget>x64</PlatformTarget>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
		<PlatformTarget>x64</PlatformTarget>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="8.0.0" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.9.0" />
		<PackageReference Include="MSTest.TestAdapter" Version="3.2.1" />
		<PackageReference Include="MSTest.TestFramework" Version="3.2.1" />
		<DotNetCliToolReference Include="Microsoft.Extensions.SecretManager.Tools" Version="1.0.1" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Ahsoka.Core.Bluetooth\Ahsoka.Core.Bluetooth.csproj" />
		<ProjectReference Include="..\Ahsoka.Core.Cygnus\Ahsoka.Core.Cygnus.csproj" />
		<ProjectReference Include="..\Ahsoka.CustomerTools\Ahsoka.CustomerTools.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\..\Ahsoka.Demo\Ahsoka.CS.Blank.Storyboard\**\*.*" Exclude="..\..\Ahsoka.Demo\Ahsoka.CS.Blank.Storyboard\bin\**\*.*;..\..\Ahsoka.Demo\Ahsoka.CS.Blank.Storyboard\obj\**\*.*">
			<Link>AhsokaDemo\%(RecursiveDir)%(Filename)%(Extension)</Link>
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<ItemGroup>
		<None Include="..\..\Ahsoka.Demo\Ahsoka.CS.CAN\**\*.*" Exclude="..\..\Ahsoka.Demo\Ahsoka.CS.CAN\bin\**\*.*;..\..\Ahsoka.Demo\Ahsoka.CS.CAN\obj\**\*.*">
			<Link>AhsokaCAN\%(RecursiveDir)%(Filename)%(Extension)</Link>
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<ItemGroup>
		<Compile Update="Properties\Resources.Designer.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>Resources.resx</DependentUpon>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Update="Properties\Resources.resx">
			<Generator>ResXFileCodeGenerator</Generator>
			<LastGenOutput>Resources.Designer.cs</LastGenOutput>
		</EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
		<None Update="Ahsoka\Resources\exampleCert\ca_root_cert.pem">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Update="Ahsoka\Resources\exampleCert\gateway_cert.pem">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Update="Ahsoka\Resources\exampleCert\gateway_key.pkcs8">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Update="BuildFolder\ApplicationOutput\TestOutput.txt">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="GitVersion.MsBuild" Version="5.12.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

</Project>
