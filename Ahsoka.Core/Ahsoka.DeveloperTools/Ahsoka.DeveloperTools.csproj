<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<RuntimeIdentifiers>win-x64;linux-arm;linux-x64;osx-arm64</RuntimeIdentifiers>
		<GeneratePackageOnBuild>false</GeneratePackageOnBuild>
		<SignAssembly>False</SignAssembly>
		<UseRidGraph>true</UseRidGraph>
		<TrimMode>partial</TrimMode>
		<AssemblyName>OpenPV.DeveloperToolkit</AssemblyName>
	</PropertyGroup>

	<PropertyGroup Label="Suppress Errors for GPIO Project">
		<SuppressWindowsPlatformTargetingRequiredError>true</SuppressWindowsPlatformTargetingRequiredError>
	</PropertyGroup>

	<PropertyGroup>
		<CFBundleName>OpenPV.DeveloperToolkit</CFBundleName> <!-- Also defines .app file name -->
		<CFBundleDisplayName>OpenPV.DeveloperToolkit</CFBundleDisplayName>
		<CFBundleIdentifier>com.openpv.customertools</CFBundleIdentifier>
		<CFBundleVersion>1.0.0</CFBundleVersion>
		<CFBundleShortVersionString>1.0</CFBundleShortVersionString>
		<CFBundlePackageType>APPL</CFBundlePackageType>
		<CFBundleSignature>123123</CFBundleSignature>
		<CFBundleExecutable>OpenPV.DeveloperToolkit</CFBundleExecutable>
		<CFBundleIconFile>OpenPV.icns</CFBundleIconFile> <!-- Will be copied from output directory -->
		<NSPrincipalClass>NSApplication</NSPrincipalClass>
		<NSHighResolutionCapable>true</NSHighResolutionCapable>
	</PropertyGroup>

	<ItemGroup>
		<None Remove=".gitignore" />
		<None Remove="Ubuntu\OpenPV.DeveloperToolkit.desktop" />
		<AvaloniaResource Include="..\..\Ahsoka.Shared\UX\Styles\Styles.axaml" Link="Styles\Styles.axaml" />
		<AvaloniaResource Include="..\..\Ahsoka.Shared\UX\Styles\UserInputStyles.axaml" Link="Styles\UserInputStyles.axaml" />
	</ItemGroup>
	
	<ItemGroup>
		<PackageReference Include="Avalonia" Version="11.1.3" />
		<PackageReference Include="Avalonia.Controls.DataGrid" Version="11.1.3" />
		<PackageReference Include="Avalonia.Controls.ItemsRepeater" Version="11.1.3" />
		<PackageReference Include="Avalonia.Desktop" Version="11.1.3" />
		<PackageReference Include="Avalonia.Themes.Fluent" Version="11.1.3" />
		<PackageReference Include="Avalonia.Svg.Skia" Version="11.1.0.1" />
		<PackageReference Include="Avalonia.Fonts.Inter" Version="11.1.3" />
		<PackageReference Include="Material.Icons.Avalonia" Version="2.1.10" />
		<PackageReference Include="Deadpikle.AvaloniaProgressRing" Version="0.10.8" />
		<PackageReference Include="MessageBox.Avalonia" Version="3.1.6" />
		<PackageReference Include="Microsoft.AspNetCore.DataProtection" Version="8.0.8" />
		<PackageReference Include="Microsoft.AspNetCore.DataProtection.Abstractions" Version="8.0.8" />
		<PackageReference Include="Microsoft.AspNetCore.DataProtection.Extensions" Version="8.0.8" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
		<PackageReference Include="NuGet.Protocol" Version="6.11.0" />
		<PackageReference Include="Packaging.Targets" Version="0.1.226">
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>

		<PackageReference Include="Dotnet.Bundle" Version="*" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Ahsoka.Core\Ahsoka.Core.csproj" />
		<ProjectReference Include="..\Ahsoka.DeveloperTools.Core\Ahsoka.DeveloperTools.Core.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Update="Assets\OpenPV-Icon.ico">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="Ubuntu\InstallQtToolchain.sh">
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
		</None>
		<AvaloniaResource Include="Assets\*" />
		<ApplicationDefinition Include="OpenPVTools\OpenViewPlatformSupport.json" />
		<Resource Include="Assets\OpenPV-Icon.ico" />
	</ItemGroup>

