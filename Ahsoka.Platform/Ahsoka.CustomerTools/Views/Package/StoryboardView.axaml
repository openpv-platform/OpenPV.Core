<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:material="using:Material.Icons.Avalonia"
             x:Class="Ahsoka.CustomerTools.Views.StoryboardView">

	<Grid >
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*"/>
			<ColumnDefinition Width="220"/>
		</Grid.ColumnDefinitions>
		
		<StackPanel HorizontalAlignment="Stretch" DataContext="{Binding StoryboardViewModel}" >
			<StackPanel.Styles>
				<StyleInclude Source="/Styles/UserInputStyles.axaml" />
			</StackPanel.Styles>
			<Border Margin="20,00,20,0" Padding="3" BorderBrush="WhiteSmoke" BorderThickness="0,0,0,0">
				<Grid IsEnabled="{Binding StoryboardProjectEnabled}" Margin="5" ColumnDefinitions="175,Auto,Auto" RowDefinitions="40,*,*,*,*,*">
					<TextBlock Text="Storyboard Info:" Grid.Row="0" Grid.Column="0"/>
					
					<TextBlock IsVisible="{Binding StoryboardProjectEnabled}" TextTrimming="CharacterEllipsis" MaxWidth="400" Text="{Binding StoryboardProjectInfoRelative, FallbackValue=(Storyboard.Build.targets Not Found)}" Grid.Row="0" Grid.Column="1"/>
					<TextBlock IsVisible="{Binding !StoryboardProjectEnabled}" Foreground="SteelBlue" TextTrimming="CharacterEllipsis" MaxWidth="400" Text="Storyboard.Build.targets Was Not Found in Project Directory" Grid.Row="0" Grid.Column="1"/>

					<TextBlock Text="Storyboard Install Folder:" Grid.Row="1" Grid.Column="0"/>
					<TextBox  IsReadOnly="True" Background="WhiteSmoke"
							  Text="{Binding StoryboardProgramFolder}" Width="300" Grid.Row="1" Grid.Column="1" />
					<Button  Margin="5,0"  Grid.Row="1" Grid.Column="2" Content="Choose Path..." Command="{Binding SetStoryboardProgramFolder}"/>

					<TextBlock Text="Storyboard Version:" Grid.Row="2" Grid.Column="0"/>
					<ComboBox Grid.Row="2" Width="300" Grid.Column="1"
							  SelectedItem="{Binding StoryboardVersion}"
							    ItemsSource="{Binding StoryboardVersions}" />

					<TextBlock Text="Storyboard Project:" Grid.Row="3" Grid.Column="0"/>
					<TextBox  IsReadOnly="True" Background="WhiteSmoke"
							  Text="{Binding StoryboardProjectFile}" Grid.Row="3" Width="300" Grid.Column="1" />
					<Button  Margin="5,0"  Grid.Row="3" Grid.Column="2" Content="Choose Path..." Command="{Binding SetStoryboardProject}"/>
				
					<TextBlock Text="Storyboard App Name:" Grid.Row="4" Grid.Column="0"/>
					<TextBox IsReadOnly="True" Background="WhiteSmoke"
							 Text="{Binding ApplicationName}" Width="300" Grid.Row="4" Grid.Column="1" />

					<TextBlock Text="Storyboard Export Folder:" Grid.Row="5" Grid.Column="0"/>
					<TextBox  IsReadOnly="True" Background="WhiteSmoke"
							  Text="{Binding StoryboardExportFolder}" Grid.Row="5" Width="300" Grid.Column="1" />
					<Button  Margin="5,0"  Grid.Row="5" Grid.Column="2" Content="Choose Path..." Command="{Binding SetStoryboardExportFolder}"/>

				</Grid>
			</Border>
		</StackPanel>
	</Grid>
</UserControl>

