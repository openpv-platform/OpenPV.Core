    },
    {
      "socketType": "TcpSocket",
      "serviceName": "CygnusService",
      "tcpListenAddress": "*",
      "tcpConnectionAddress": "localhost",
      "dataChannel": 5112,
      "behaviors": "AutoStart"
    }
  ],
  "hasCommands": "false",
  "hasUx": "false",
  "minVersion": "3.5.0",
  "maxVersion": "4.0.0",
  "requireExactVersion": "false"
