<Project>


	<ItemGroup Label="Native Libraries for GLES">
		
		<Content Include="..\..\BuildOutputs\Ahsoka.Services\Ahsoka.Drawing.OpenViewLinux.so">
			<Link>AhsokaLib\Ahsoka.Drawing.OpenViewLinux.so</Link>
			<PackagePath>contentFiles/any/any/AhsokaLib/Ahsoka.Drawing.OpenViewLinux.so</PackagePath>
			<PackageCopyToOutput>true</PackageCopyToOutput>
			<IncludeInPackage>true</IncludeInPackage>
			<Pack>true</Pack>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Visible>true</Visible>
		</Content>
		<Content Include="..\..\BuildOutputs\Ahsoka.Services\Ahsoka.Drawing.OpenViewLinuxPro.so">
			<Link>AhsokaLib\Ahsoka.Drawing.OpenViewLinuxPro.so</Link>
			<PackagePath>contentFiles/any/any/AhsokaLib/Ahsoka.Drawing.OpenViewLinuxPro.so</PackagePath>
			<PackageCopyToOutput>true</PackageCopyToOutput>
			<IncludeInPackage>true</IncludeInPackage>
			<Pack>true</Pack>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Visible>true</Visible>
		</Content>
	</ItemGroup>
</Project>