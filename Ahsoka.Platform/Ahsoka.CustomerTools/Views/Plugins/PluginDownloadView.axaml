<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:material="using:Material.Icons.Avalonia"
             x:Class="Ahsoka.CustomerTools.Views.PluginDownloadView">
	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*"/>
			<ColumnDefinition Width="220"/>
		</Grid.ColumnDefinitions>

		<StackPanel Grid.Column="1"
					HorizontalAlignment="Center" >

			<Button Margin="3,5,5,3"
						HorizontalAlignment="Stretch"
						Height="38"
						VerticalContentAlignment="Center"
						Command="{Binding DownloadTool}" >
				<StackPanel Orientation="Horizontal">
					<material:MaterialIcon Width="24" Height="24" Foreground="SteelBlue" Kind="Download"></material:MaterialIcon>
					<TextBlock Margin="6,0" VerticalAlignment="Center" FontSize="13"  Text="Download Plugin"/>
				</StackPanel>
			</Button>
			<Button Margin="3,3,5,3"
						HorizontalAlignment="Stretch"
						Height="38"
						VerticalContentAlignment="Center"
						Command="{Binding RemoveTool}" >
				<StackPanel Orientation="Horizontal">
					<material:MaterialIcon Width="24" Height="24" Foreground="SteelBlue" Kind="Delete"></material:MaterialIcon>
					<TextBlock Margin="6,0" VerticalAlignment="Center" FontSize="13"  Text="Remove Download"/>
				</StackPanel>
			</Button>
			<Border IsVisible="{Binding CanInstall}" 
					Margin="2,10,2,6" Padding="3" BorderBrush="LightGray" BorderThickness="0,1,0,0" />
			
			<Button Margin="3,3,5,3"
							HorizontalAlignment="Stretch"
							Height="38"
							VerticalContentAlignment="Center"
							IsVisible="{Binding CanInstall}" 
							Command="{Binding ShowInstallHelp}" >
				<StackPanel Orientation="Horizontal">
					<material:MaterialIcon Width="24" Height="24" Foreground="SteelBlue" Kind="Export"></material:MaterialIcon>
					<TextBlock Margin="6,0" VerticalAlignment="Center" FontSize="13"  Text="Install..."/>
				</StackPanel>
			</Button>
				<Button Margin="3,3,5,3"
						HorizontalAlignment="Stretch"
						Height="38"
						VerticalContentAlignment="Center"
						IsVisible="{Binding CanLaunch}" 
						Command="{Binding LaunchTool}" >
				<StackPanel Orientation="Horizontal">
					<material:MaterialIcon Width="24" Height="24" Foreground="SteelBlue" Kind="Download"></material:MaterialIcon>
					<TextBlock Margin="6,0" VerticalAlignment="Center" FontSize="13"  Text="Launch..."/>
				</StackPanel>
			</Button>
		<Border Margin="2,10,2,6" Padding="3" BorderBrush="LightGray" BorderThickness="0,1,0,0" />
			<Button Margin="3,3,5,3"
					HorizontalAlignment="Stretch"
					Height="38"
					VerticalContentAlignment="Center"
					Command="{Binding RefreshTools}" >
				<StackPanel Orientation="Horizontal">
					<material:MaterialIcon Width="24" Height="24" Foreground="SteelBlue" Kind="Refresh"></material:MaterialIcon>
					<TextBlock Margin="6,0" VerticalAlignment="Center" FontSize="13"  Text="Refresh List"/>
				</StackPanel>
			</Button>
			
		</StackPanel>

		<Border  Padding="3" BorderBrush="WhiteSmoke" BorderThickness="0,-10,0,0">
			<DataGrid Grid.ColumnSpan="1" Name="Releases" SelectionMode="Single"
					 ItemsSource="{Binding SelectedPlatformSupport.Downloads}" SelectedItem="{Binding SelectedTool}" Margin="0,10,20,0"   AutoGenerateColumns="False">
				<DataGrid.Columns>
					<DataGridTextColumn FontSize="12" Header="Package Type" Width="140" Binding="{Binding PackageType}" IsReadOnly="True"/>
					<DataGridTextColumn FontSize="12" Header="Name" Width="*" Binding="{Binding Name}" IsReadOnly="True"/>
					<DataGridTextColumn FontSize="12" Header="Version" Width="*" Binding="{Binding Version}" IsReadOnly="True"/>
					<DataGridCheckBoxColumn Header="Downloaded"  Width="120" Binding="{Binding IsDownloaded}" IsReadOnly="True"/>
				</DataGrid.Columns>
			</DataGrid>
		</Border>

		<Border IsVisible="{Binding InstallHelpVisible}" Grid.ColumnSpan="2"  BorderThickness="0,0,0,0" Margin="0,0,0,0" >
			<Border  BoxShadow="5 5 10 2 DarkGray" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.ColumnSpan="2" BorderBrush="DarkGray" Background="White" BorderThickness="1">
				<StackPanel VerticalAlignment="Center">
					<TextBlock Margin="25,25,25,0" Width="450" Foreground="SteelBlue" FontSize="16" TextWrapping="Wrap" TextAlignment="Center"
							   VerticalAlignment="Center" HorizontalAlignment="Center" 
							   Padding="10" Text="{Binding SelectedTool.InstallText, FallbackValue=Install Help...}"/>

					<StackPanel Margin="25" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
						<Button Grid.Column="2" Grid.Row="0"
							HorizontalAlignment="Center"
							VerticalAlignment="Center"
							Command="{Binding InstallTool}" FontSize="14"
							Background="Transparent" Content="Continue..."/>

						<Button Grid.Column="2" Grid.Row="0"
									HorizontalAlignment="Center"
									VerticalAlignment="Center"
									Command="{Binding CancellInstall}" FontSize="14"
									Background="Transparent" Content="Cancel"/>
					</StackPanel>

					
				</StackPanel>
			</Border>
		</Border>
	</Grid>
</UserControl>