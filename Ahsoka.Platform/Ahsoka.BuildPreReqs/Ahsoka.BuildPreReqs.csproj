<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net7.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<!--Disable Build Outputs-->
	<Target Name="Build" />
	<Target Name="Rebuild" />

	<PropertyGroup>
		<PreReqSourceRoot>$([System.IO.Path]::GetFullPath('$(SolutionDir)..\'))</PreReqSourceRoot>
	</PropertyGroup>
	
	<Target Name="BuildPreReqs" BeforeTargets="PreBuildEvent">
		<MSBuild Projects="../Ahsoka.BuildInterop/Ahsoka.BuildInterop.csproj;../Ahsoka.BuildCoprocessor/Ahsoka.BuildCoprocessor.csproj;../Ahsoka.BuildEsp32/Ahsoka.BuildEsp32.csproj" BuildInParallel="false" StopOnFirstFailure="true" RunEachTargetSeparately="false" />
	</Target>

	<Target Name="CleanPreReqs" AfterTargets="BeforeClean">
		<MSBuild Projects="../Ahsoka.BuildInterop/Ahsoka.BuildInterop.csproj;../Ahsoka.BuildCoprocessor/Ahsoka.BuildCoprocessor.csproj;../Ahsoka.BuildEsp32/Ahsoka.BuildEsp32.csproj" Targets="BeforeClean" BuildInParallel="false" StopOnFirstFailure="true" RunEachTargetSeparately="false" />
	</Target>
	
</Project>
