<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>disable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<InvariantGlobalization>true</InvariantGlobalization>
		<PublishAot>false</PublishAot>
	</PropertyGroup>

  <ItemGroup>
    <Content Remove="OpenLinuxST.PackageInfo.json" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Platform_OpenView\OpenView.PackageInfo.json" />
  </ItemGroup>

	<ItemGroup>
		<Compile Remove="publish\**" />
		<Content Remove="publish\**" />
		<EmbeddedResource Remove="publish\**" />
		<None Remove="publish\**" />
	</ItemGroup>

	<Import Label="Ahsoka Local Build Properties" Condition="Exists('../Demo.Build.props')" Project="../Demo.Build.props" />

	<ItemGroup Label="Reference to Ahsoka Nuget Packages" Condition="!Exists('../Demo.Build.props')">
		<PackageReference Include="Ahsoka.Core" Version="4.*-*" />
	</ItemGroup>

</Project>
