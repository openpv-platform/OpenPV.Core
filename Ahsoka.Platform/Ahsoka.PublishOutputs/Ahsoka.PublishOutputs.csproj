<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<UserSecretsId>5861d827-1f17-41c9-9344-c2616ea52eb6</UserSecretsId>
	</PropertyGroup>
	
	<!--Disable Build Outputs-->
	<Target Name="Build" />
	<Target Name="Rebuild" />
	
	<PropertyGroup>
		<PlatformSupportRoot>$(SolutionDir)..\</PlatformSupportRoot>
	</PropertyGroup>

	<Target Name="Clean Platform Support Folders" BeforeTargets="BeforeClean">
		
		<Message Text="Clean Platform Support Folders at $(PlatformSupportRoot)" Importance="high" />
		<RemoveDir Directories="$(PlatformSupportRoot)PlatformSupport\" />
		<RemoveDir Directories="$(PlatformSupportRoot)Extensions\" />
		<RemoveDir Directories="$(PlatformSupportRoot)SparkUpload\" />
		<MakeDir Directories="$(PlatformSupportRoot)PlatformSupport\" />
		<MakeDir Directories="$(PlatformSupportRoot)Extensions\" />
		<MakeDir Directories="$(PlatformSupportRoot)SparkUpload\" />
		
	</Target>

	<Target Name="BuildSupportPackages" Condition="true" AfterTargets="PostBuildEvent">
		
		<MSBuild Projects="../Ahsoka.PublishWindows/Ahsoka.PublishWindows.csproj;&#xD;&#xA;							../Ahsoka.PublishOpenView/Ahsoka.PublishOpenView.csproj;&#xD;&#xA;							../Ahsoka.PublishOpenViewPro/Ahsoka.PublishOpenViewPro.csproj;&#xD;&#xA;							../Ahsoka.PublishUbuntu/Ahsoka.PublishUbuntu.csproj;" BuildInParallel="false" StopOnFirstFailure="true" RunEachTargetSeparately="false" />
		
		<!--Copy Spark Package Manifst to Output -->
		<Copy SourceFiles="OpenPV Dependencies.release.json" DestinationFiles="$(PlatformSupportRoot)\SparkUpload\OpenPV Dependencies.release.json" />
	</Target>

	<Target Name="BuildDemosAndExtensions" AfterTargets="BuildSupportPackages">

		<MSBuild Projects=";../Ahsoka.PublishPowerVision/Ahsoka.PublishPowerVision.csproj;../Ahsoka.PublishNuget/Ahsoka.PublishNuget.csproj;../Ahsoka.PublishExtensions/Ahsoka.PublishExtensions.csproj;../Ahsoka.PublishDemos/Ahsoka.PublishDemos.csproj" BuildInParallel="true" StopOnFirstFailure="true" RunEachTargetSeparately="true" />
	</Target>

	<ItemGroup>
		<PackageReference Include="GitVersion.MsBuild" Version="5.12.0">
	    <PrivateAssets>all</PrivateAssets>
	    <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
	  </PackageReference>
	</ItemGroup>
	
</Project>

