<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<UserSecretsId>5861d827-1f17-41c9-9344-c2616ea52eb6</UserSecretsId>
	</PropertyGroup>
	
	<!--Disable Build Outputs-->
	<Target Name="Build" />
	<Target Name="Rebuild" />
	
	<PropertyGroup>
		<PlatformSupportRoot>$(SolutionDir)</PlatformSupportRoot>
	</PropertyGroup>

	<Target Name="Clean Platform Support Folders" BeforeTargets="BeforeClean">
		<Message Text="Clean Platform Support Folders at $(PlatformSupportRoot)" Importance="high" />
		<RemoveDir Directories="$(PlatformSupportRoot)\PlatformSupport\" />
		<RemoveDir Directories="$(PlatformSupportRoot)\SparkUpload\" />

		<MakeDir Directories="$(PlatformSupportRoot)\PlatformSupport\" />
		<MakeDir Directories="$(PlatformSupportRoot)\SparkUpload\" />
		<MakeDir Directories="$(PlatformSupportRoot)\SparkUpload\APIHelp\" />
	</Target>

	<Target Name="GenerateHelp" BeforeTargets="PreBuildEvent" Condition="'$(OS)' != 'Unix'">
		
		<MakeDir Directories="$(PlatformSupportRoot)\PlatformSupport\" />
		<MakeDir Directories="$(PlatformSupportRoot)\SparkUpload\" />
		<MakeDir Directories="$(PlatformSupportRoot)\SparkUpload\APIHelp\" />

		<Message Text="BuildHelpOutput" Importance="High" />
		<Exec WorkingDirectory="$(PlatformSupportRoot)\Ahsoka.Core\Ahsoka.Core"  Command="$(PlatformSupportRoot)\Ahsoka.ThirdParty\Doxygen\doxygen.exe .\Docs\Doxyfile"  />
		<ZipDirectory Overwrite="true" SourceDirectory="$(PlatformSupportRoot)\SparkUpload\APIHelp\" DestinationFile="$(PlatformSupportRoot)\SparkUpload\OpenPV Help.zip" />
		<Copy SourceFiles="$(PlatformSupportRoot)\Ahsoka.Core\Ahsoka.Core\OpenPV Help.release.json" DestinationFiles="$(PlatformSupportRoot)\SparkUpload\OpenPV Help.release.json"/>
		<RemoveDir Directories="$(PlatformSupportRoot)\SparkUpload\APIHelp\"/>
	</Target>

	<Target Name="BuildSupportPackages" Condition="true" AfterTargets="PostBuildEvent">
		<MSBuild Projects="../Ahsoka.PublishWindows/Ahsoka.PublishWindows.csproj;
				 ../Ahsoka.PublishUbuntu/Ahsoka.PublishUbuntu.csproj;
				 ../Ahsoka.PublishOpenView/Ahsoka.PublishOpenView.csproj;
				 ../Ahsoka.PublishOpenViewPro/Ahsoka.PublishOpenViewPro.csproj;" 
				 BuildInParallel="false" StopOnFirstFailure="true" 
				 RunEachTargetSeparately="true" />

		<!--Copy Spark Package Manifst to Output -->
		<Copy SourceFiles="OpenPV Dependencies.release.json" DestinationFiles="$(PlatformSupportRoot)\SparkUpload\OpenPV Dependencies.release.json" />
	</Target>

	<Target Name="BuildDemosAndExtensions" AfterTargets="BuildSupportPackages">
		<MSBuild Projects="../Ahsoka.PublishPowerVision/Ahsoka.PublishPowerVision.csproj;../Ahsoka.PublishNuget/Ahsoka.PublishNuget.csproj;../Ahsoka.PublishExtensions/Ahsoka.PublishExtensions.csproj;../Ahsoka.PublishDemos/Ahsoka.PublishDemos.csproj" BuildInParallel="true" StopOnFirstFailure="true" RunEachTargetSeparately="true" />
	</Target>

	<ItemGroup>
		<PackageReference Include="GitVersion.MsBuild" Version="[5.12.0]">
	    <PrivateAssets>all</PrivateAssets>
	    <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
	  </PackageReference>
	</ItemGroup>
	
</Project>

