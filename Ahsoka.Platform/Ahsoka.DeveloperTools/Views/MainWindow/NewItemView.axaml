<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             xmlns:material="using:Material.Icons.Avalonia" Background="#33555555"
             x:Class="Ahsoka.DeveloperTools.Views.NewItemView">
	<UserControl.Styles>
		<StyleInclude Source="/Styles/UserInputStyles.axaml" />
	</UserControl.Styles>
	<Grid  VerticalAlignment="Center" HorizontalAlignment="Center" >
		<Border BorderBrush="DarkGray" BorderThickness="1" Background="White">
			<StackPanel >
				<Border BorderBrush="Gainsboro" Background="WhiteSmoke" BorderThickness="0,0,0,1" DockPanel.Dock="Top">
					<DockPanel LastChildFill="False">
						<TextBlock Text="{Binding Title, FallbackValue=Title}" Foreground="DodgerBlue" FontSize="16" Margin="0" Padding="10"/>
						<Button DockPanel.Dock="Right"  Content="Cancel" Command="{Binding Cancel}" />
						<Button DockPanel.Dock="Right"  Content="Ok" Command="{Binding Accept}" />
					</DockPanel>
				</Border>
				<Border Margin="20,20,20,20" Padding="3" BorderBrush="WhiteSmoke" BorderThickness="0,0,0,0">
					<Grid Margin="5" ColumnDefinitions="125,Auto" RowDefinitions="*,*,*,*,*">
						<TextBlock Text="{Binding Label, FallbackValue=Label}" Grid.Row="0" Grid.Column="0"/>
						<TextBox  Focusable="True"  AcceptsTab="False" AcceptsReturn="False"  Name="ItemText" Text="{Binding ItemText, FallbackValue=ItemText}" Grid.Row="0" Width="450" TextWrapping="NoWrap" Grid.Column="1" />
						<TextBlock Text="{Binding Hint, FallbackValue=Hint}" Margin="0" Grid.Row="3" HorizontalAlignment="Center" Foreground="Gray" Grid.ColumnSpan="2" Padding="10"/>
					</Grid>
				</Border>
			</StackPanel>
		</Border>
	</Grid>
</UserControl>

