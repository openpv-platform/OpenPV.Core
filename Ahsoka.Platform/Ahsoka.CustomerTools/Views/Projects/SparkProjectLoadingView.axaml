<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:material="using:Material.Icons.Avalonia"
			 xmlns:progRing="clr-namespace:AvaloniaProgressRing;assembly=AvaloniaProgressRing"
			 xmlns:CustomerTools="clr-namespace:Ahsoka.CustomerTools.Views"
			 mc:Ignorable="d" d:DesignWidth="850" d:DesignHeight="450"
             x:Class="Ahsoka.CustomerTools.Views.SparkProjectLoadingView" >

	<Border  IsVisible="{Binding ParentViewModel.ParentViewModel.IsWorking, FallbackValue=true}" 
			 BorderBrush="DarkGray" Background="Transparent" BorderThickness="0,0,0,0" Margin="0,0,0,0" >
		<Border HorizontalAlignment="Center" VerticalAlignment="Center"  BoxShadow="5 5 10 2 DarkGray" Grid.ColumnSpan="2" BorderBrush="DarkGray" Background="White" BorderThickness="1">
			<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="50">

				<progRing:ProgressRing Width="30"  Height="30" IsActive="True"   Foreground="SteelBlue" />
				<TextBlock  Foreground="SteelBlue" FontSize="16"
							   VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,5"
							   Padding="10" Text="{Binding ParentViewModel.ParentViewModel.WorkingText, FallbackValue='Update Project'}"/>

			</StackPanel>
		</Border>
	</Border>
</UserControl>
