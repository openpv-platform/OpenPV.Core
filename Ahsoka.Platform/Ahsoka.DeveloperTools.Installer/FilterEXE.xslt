<?xml version="1.0" encoding="utf-8"?>
<xsl:stylesheet
  version="1.0"
  xmlns="http://wixtoolset.org/schemas/v4/wxs"
  xmlns:xsl="http://www.w3.org/1999/XSL/Transform"
  xmlns:wix="http://wixtoolset.org/schemas/v4/wxs"
  xmlns:str="http://xsltsl.org/string"
  exclude-result-prefixes="wix str"
  >

	<xsl:output
	  encoding="utf-8"
	  method="xml"
	  version="1.0"
	  indent="yes"
    />
	
	<xsl:template match='wix:Component[contains(wix:File/@Source, "OpenPV.DeveloperToolkit.exe")]'/>

	<!-- identity template -->
	<xsl:template match="@*|node()">
		<xsl:copy>
			<xsl:apply-templates select="@*|node()"/>
		</xsl:copy>
	</xsl:template>

	<xsl:template match='/'>
		<xsl:comment>*** DO NOT EDIT: Generated by heat.exe; transformed by FilterExePDB.xsl</xsl:comment>
		<xsl:apply-templates select="@*|node()"/>
	</xsl:template>

</xsl:stylesheet>