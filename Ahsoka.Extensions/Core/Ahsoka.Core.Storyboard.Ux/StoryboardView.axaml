<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="650"
             xmlns:material="using:Material.Icons.Avalonia"
             x:Class="Ahsoka.DeveloperTools.Views.StoryboardView">

	<Grid >
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*"/>
			<ColumnDefinition Width="220"/>
		</Grid.ColumnDefinitions>
		
		<StackPanel HorizontalAlignment="Stretch"  >
			<StackPanel.Styles>
				<StyleInclude Source="/Styles/UserInputStyles.axaml" />
			</StackPanel.Styles>
			<TextBlock Text="Configure Storyboard Code Generators" Margin="10,10,0,0"
				   FontSize="25" Foreground="SteelBlue" DockPanel.Dock="Top"/>
			
			<Border Margin="20,00,20,0" Padding="3" BorderBrush="WhiteSmoke" BorderThickness="0,0,0,0">
				<StackPanel>
					<Grid Margin="5" ColumnDefinitions="185,Auto,Auto,Auto"
						  RowDefinitions="40,*,*,15,*,*,*,*">

						<TextBlock Text="Storyboard Config File:" Grid.Row="0" Grid.Column="0"/>
						<TextBox  Background="WhiteSmoke" IsReadOnly="True" HorizontalAlignment="Left"
							 Grid.Row="0" Grid.Column="1" Text="{Binding ConfigurationPath}"
							 Width="300"  />

					
						<TextBlock Text="Storyboard Project:" Grid.Row="1" Grid.Column="0"/>
						<TextBox IsReadOnly="True" Background="WhiteSmoke"
								  Text="{Binding StoryboardProjectFile}" Grid.Row="1"
								  Width="300" Grid.Column="1" />
						<Button  Margin="5,0"  Grid.Row="1" Grid.Column="2" Content="Choose Path..."
								 Command="{Binding SetStoryboardProject}"/>

						<TextBlock Text="Storyboard App Name:" Grid.Row="2" Grid.Column="0"/>
						<TextBox IsReadOnly="True" Background="WhiteSmoke"
								 Text="{Binding ApplicationName}" Width="300" 
								 Grid.Row="2" Grid.Column="1" />
	
						<TextBlock Text="Model Generator Enabled:" Grid.Row="4" Grid.Column="0"/>
						<CheckBox HorizontalAlignment="Stretch" BorderBrush="DimGray"
								 Grid.Row="4" Margin="3,10" Grid.Column="1" IsChecked="{Binding ModelGeneratorEnabled}" />
						<TextBlock Text="The Storyboard Model Generator will generate model objects for your C# application."
								   Grid.Row="4" Grid.Column="1" Margin="30,6,0,0" VerticalAlignment="Center"
								   TextWrapping="WrapWithOverflow" MaxWidth="300" MinHeight="40"
								   Foreground="DimGray"/>

						<TextBlock Text="Model Output Folder:" Grid.Row="5" Grid.Column="0"/>
						<TextBox IsReadOnly="True" Background="WhiteSmoke" HorizontalAlignment="Left"
								 Grid.Row="5" Grid.Column="1" Text="{Binding GeneratorOutputFolder}"
								 Width="300"  />
						<Button  Margin="5,0"  Grid.Row="5" Grid.Column="2" Content="Choose Path..."
												 Command="{Binding SetStoryboardOutput}"/>

						<TextBlock Text="Model Namespace:" Grid.Row="6" Grid.Column="0"/>
						<TextBox HorizontalAlignment="Left"
								 Grid.Row="6" Grid.Column="1" Text="{Binding GeneratorNameSpace}"
								 Width="300"  />

						<TextBlock Text="Model Base Class:" Grid.Row="7" Grid.Column="0"/>
						<TextBox HorizontalAlignment="Left"
								 Grid.Row="7" Grid.Column="1" Text="{Binding GeneratorBaseClass}"
								 Width="300"  />

					</Grid>
					
					<Grid Margin="5" ColumnDefinitions="185,Auto,Auto,Auto"
						  RowDefinitions="15,*,*,*,*,*">
					
						<TextBlock Text="App Exporter Enabled:" Grid.Row="1" Grid.Column="0"/>
						<CheckBox HorizontalAlignment="Stretch" BorderBrush="DimGray"
								 Grid.Row="1" Margin="3,10" Grid.Column="1" IsChecked="{Binding AppGeneratorEnabled}" />
						<TextBlock Text="The App Compiler will export your Storyboard Application to the Output Folder."
								   Grid.Row="1" Grid.Column="1" Margin="30,6,0,0" VerticalAlignment="Center"
								   TextWrapping="WrapWithOverflow" MaxWidth="300" MinHeight="40"
								   Foreground="DimGray"/>

						
					<TextBlock Text="Storyboard Application:" Grid.Row="2" Grid.Column="0"/>
					<TextBox  IsReadOnly="True" Background="WhiteSmoke"
							  Text="{Binding StoryboardAppProgramFolder}" Grid.Row="2" Width="300" Grid.Column="1" />
					<Button  Margin="5,0"  Grid.Row="2" Grid.Column="2" Content="Choose Path..." Command="{Binding SetStoryboardProgramFolder}"/>
				
					<TextBlock Text="Storyboard Version:" Grid.Row="3" Grid.Column="0"/>
					<ComboBox Grid.Row="3" Width="300" Grid.Column="1"
							  SelectedItem="{Binding StoryboardAppVersion}"
							    ItemsSource="{Binding StoryboardVersions}" />
				
					<TextBlock Text="Storyboard Export Folder:" Grid.Row="5" Grid.Column="0"/>
					<TextBox  IsReadOnly="True" Background="WhiteSmoke"
							  Text="{Binding StoryboardAppExportFolder}" Grid.Row="5" Width="300" Grid.Column="1" />
					<Button  Margin="5,0"  Grid.Row="5" Grid.Column="2" Content="Choose Path..." Command="{Binding SetStoryboardExportFolder}"/>
					</Grid>
				</StackPanel>
			</Border>
		</StackPanel>
	</Grid>
</UserControl>

