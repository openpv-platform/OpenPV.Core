<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<!--Disable Build Outputs-->
	<Target Name="Build" />
	<Target Name="Rebuild" />

	<PropertyGroup>
		<PlatformSupportRoot>$(SolutionDir)</PlatformSupportRoot>
	</PropertyGroup>

	<Target Name="Clean BuildOutputs" BeforeTargets="BeforeClean">
		<Message Text="Cleaning OpenView BuildOutputs" Importance="high" />
		<RemoveDir Directories="$(PlatformSupportRoot)\PlatformSupport\OpenViewLinuxPro_TargetSupport\" />
		<Delete Files="$(PlatformSupportRoot)\SparkUpload\OpenViewLinuxPro_TargetSupport.zip" />
	</Target>

	<Target Name="CreateOpenViewProPublishOutputs" AfterTargets="PostBuildEvent" Condition="!Exists('$(PlatformSupportRoot)\SparkUpload\OpenViewLinuxPro_TargetSupport.zip')">

		<!-- Copy BSP from Download Area -->
		<ItemGroup>
			<DISTRO_FIRMWARE Include="$(SolutionDir)FirmwareDownload\OpenViewLinuxPro_TargetSupport\Firmware\**" />
		</ItemGroup>

		<!--Copy Distro and Upgrade Files-->
		<Copy SourceFiles="@(DISTRO_FIRMWARE)" DestinationFolder="$(PlatformSupportRoot)\PlatformSupport\OpenViewLinuxPro_TargetSupport\Firmware\%(RecursiveDir)" />

		<!-- Create OpenView "Select" Target Support Package (For Prep, Runtimes, Etc.) -->
		<Exec Command="dotnet publish ../Ahsoka.Installer.UI/Ahsoka.Installer.UI.csproj -p:PublishProfile=LinuxProOutputs" />
		<WriteLinesToFile File="$(PlatformSupportRoot)\PlatformSupport\OpenViewLinuxPro_TargetSupport\InstallerUI\InstallerVersion.txt" Lines="$(GitVersion_SemVer)" Overwrite="true" Encoding="UTF-8" />
		<WriteLinesToFile File="$(PlatformSupportRoot)\PlatformSupport\OpenViewLinuxPro_TargetSupport\OpenViewLinuxPro_TargetSupport.zip.customertools.version" Lines="$(GitVersion_SemVer)" Overwrite="true" Encoding="UTF-8" />

		<Exec Command="dotnet publish ../Ahsoka.CommandLine/Ahsoka.CommandLine.csproj -p:PublishProfile=LinuxProOutputs" />

		<!-- Dependencies for OpenView "Select" -->
		<ItemGroup>
			<OV_Dependencies Include="..\..\Ahsoka.Thirdparty\PreBuiltArm64\**" />
			<!--<OV_Firmware Include="$(PlatformSupportRoot)\BuildOutputs\Firmware\OpenViewLinuxPro_TargetSupport\**" />-->
			<OV_HardwareDefs Include="*HardwareConfiguration.json" />
		</ItemGroup>
		<Copy SourceFiles="@(OV_Dependencies)" DestinationFolder="$(PlatformSupportRoot)\PlatformSupport\OpenViewLinuxPro_TargetSupport\Dependency\%(RecursiveDir)" />
		<!--<Copy SourceFiles="@(OV_Firmware)" DestinationFolder="$(PlatformSupportRoot)\PlatformSupport\OpenViewLinuxPro_TargetSupport\Resources\%(RecursiveDir)" />-->
		<Copy SourceFiles="@(OV_HardwareDefs)" DestinationFolder="$(PlatformSupportRoot)\PlatformSupport\OpenViewLinuxPro_TargetSupport\Hardware\%(RecursiveDir)" />

		<!-- Create OpenView "Select" Package -->
		<ZipDirectory Overwrite="true" SourceDirectory="$(PlatformSupportRoot)\PlatformSupport\OpenViewLinuxPro_TargetSupport\" DestinationFile="$(PlatformSupportRoot)\SparkUpload\OpenViewLinuxPro_TargetSupport.zip" />

	</Target>

	<ItemGroup>
		<PackageReference Include="GitVersion.MsBuild" Version="5.12.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

</Project>
