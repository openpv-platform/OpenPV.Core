<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:material="using:Material.Icons.Avalonia"
             x:Class="Ahsoka.DeveloperTools.Views.AboutView">

	<Grid DataContext="{Binding ParentViewModel.About}" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
		
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*"/>
			<ColumnDefinition Width="220"/>
		</Grid.ColumnDefinitions>
		
		<StackPanel Grid.Column="1" Grid.RowSpan="3" VerticalAlignment="Top"
					HorizontalAlignment="Center"  >
			<Button Margin="3,27,5,3"
					HorizontalAlignment="Stretch"
					Height="38"
					VerticalContentAlignment="Center"
					Command="{Binding ShowLicense}" >
				<StackPanel Orientation="Horizontal">
					<material:MaterialIcon Width="24" Height="24" Foreground="SteelBlue" Kind="Web"></material:MaterialIcon>
					<TextBlock Margin="6,0" VerticalAlignment="Center" FontSize="13"  Text="Show License"/>
				</StackPanel>
			</Button>
			<Button Margin="3,3,5,3"
					HorizontalAlignment="Stretch"
					Height="38"
					VerticalContentAlignment="Center"
					Command="{Binding ToggleInternalCLI}" >
				<StackPanel Orientation="Horizontal">
					<material:MaterialIcon Width="24" Height="24" Foreground="SteelBlue" Kind="Console"></material:MaterialIcon>
					<TextBlock IsVisible="{Binding ParentViewModel.UseInternalCommandLine}" Margin="6,0" VerticalAlignment="Center" FontSize="13" 
							   Text="Use External CLI"/>
					<TextBlock IsVisible="{Binding !ParentViewModel.UseInternalCommandLine, FallbackValue=false}"
							   Margin="6,0" VerticalAlignment="Center" FontSize="13" 
							   Text="Use Internal CLI"/>
				</StackPanel>
			</Button>
		</StackPanel>

		<DockPanel Margin="10,20,10,30" LastChildFill="True" VerticalAlignment="Stretch"  Grid.Row="0">

			<Border Padding="3" DockPanel.Dock="Top"  BorderBrush="WhiteSmoke" BorderThickness="0,0,0,0">
				<TextBlock Text="About OpenPV Tools and SDKs" FontSize="18" VerticalAlignment="Center" Margin="5"/>
			</Border>

			<Border Padding="3" DockPanel.Dock="Top"  BorderBrush="WhiteSmoke" BorderThickness="0,0,0,0">
				<Grid Margin="5" ColumnDefinitions="auto,*" RowDefinitions="*,*,*,*,*,*,*,*" >
					<TextBlock FontSize="12" Text="Product Version:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="20,5,5,5"/>
					<TextBlock FontSize="12" HorizontalAlignment="Left" Text="{Binding Version, FallbackValue='VersionText'}" Grid.Row="2" Grid.Column="1" Margin="20,5,5,5"/>

					<TextBlock FontSize="12" Text="Build Version:" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Margin="20,5,5,5"/>
					<TextBlock FontSize="12" HorizontalAlignment="Left" Text="{Binding FullVersion, FallbackValue='FullVersion'}" Grid.Row="3" Grid.Column="1" Margin="20,5,5,5"/>

					<TextBlock FontSize="12" Text="Copyright:" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Margin="20,5,5,5"/>
					<TextBlock FontSize="12" HorizontalAlignment="Left" Text="{Binding Copyright, FallbackValue='CopyrightText'}" Grid.Row="4" Grid.Column="1" Margin="20,5,5,5"/>
					
					<TextBlock FontSize="12" Text="Use Internal CLI:" Grid.Row="6" Grid.Column="0" VerticalAlignment="Center" Margin="20,5,5,5"/>
					<TextBlock FontSize="12" HorizontalAlignment="Left"
							   ToolTip.Tip="This debugging feature will enable the internal command line instead of the one included in the installed Target Package"
							   Text="{Binding ParentViewModel.UseInternalCommandLine, FallbackValue='true'}" Grid.Row="6" Grid.Column="1" Margin="20,5,5,5"/>
				</Grid>
			</Border>

			<Border Margin="0,10,0,0" Padding="3" DockPanel.Dock="Top" BorderBrush="WhiteSmoke" BorderThickness="0,0,0,0">
				<TextBlock Text="Open Source License Info" FontSize="18" VerticalAlignment="Center" Margin="5"/>
			</Border>

			<DataGrid DockPanel.Dock="Bottom" Margin="20,10,20,20"
						ItemsSource="{Binding Licenses}"
						SelectedItem="{Binding SelectedLicense}"
						AutoGenerateColumns="False" RowHeight="20">
				<DataGrid.Columns>
					<DataGridTextColumn FontSize="10" Header="License Name" Binding="{Binding PackageName}" IsReadOnly="True"/>
					<DataGridTextColumn FontSize="10"  Header="License Type" Binding="{Binding LicenseType}" IsReadOnly="True"/>
					<DataGridTextColumn FontSize="10"  Header="Version" Binding="{Binding PackageVersion}" IsReadOnly="True"/>
					<DataGridTextColumn FontSize="10"  Header="Copyright" Binding="{Binding Copyright}" IsReadOnly="True"/>
				</DataGrid.Columns>
			</DataGrid>
		</DockPanel>
	</Grid>
	
</UserControl>