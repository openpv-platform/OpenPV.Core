<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:material="using:Material.Icons.Avalonia"
             xmlns:CustomerTools="clr-namespace:Ahsoka.CustomerTools.Views"
			 xmlns:progRing="clr-namespace:AvaloniaProgressRing;assembly=AvaloniaProgressRing"
			 mc:Ignorable="d" d:DesignWidth="850" d:DesignHeight="450"  Background="#33555555"
             x:Class="Ahsoka.CustomerTools.Views.SparkProjectModuleList">

	<Border Margin="20" BoxShadow="5 5 10 2 DarkGray" BorderBrush="DarkGray" 
			BorderThickness="1" Background="White">
		<Grid Margin="10,10,0,10"  ColumnDefinitions="*,220" >
			<Grid Margin="5" RowDefinitions="Auto,Auto,*" >
			
				<Border Grid.Row="1" BorderBrush="Gainsboro"  BorderThickness="0,1,0,0" 
						Margin="20,32,-10,20" Height="2"/>
				<TextBlock Grid.Row="1" FontSize="24"  Margin="10,17,0,0"  
						   Text="{Binding ParentViewModel.TeamName, StringFormat='Modules Licensed for {0} ', FallbackValue='Modules Licensed for None '}"
						   Foreground="SteelBlue" HorizontalAlignment="Left" Background="White"  />

				<Grid Grid.Row="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"  Margin="15,5,0,5" >
					<ScrollViewer IsVisible="{Binding HasModules}" VerticalScrollBarVisibility="Auto" 
								  HorizontalScrollBarVisibility="Disabled">
						<ItemsRepeater VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
									   ItemsSource="{Binding ModuleList}">
							<ItemsRepeater.Layout>
								<StackLayout Spacing="0" Orientation="Vertical"/>
							</ItemsRepeater.Layout>
							<ItemsRepeater.ItemTemplate>
								<DataTemplate>
									<CustomerTools:SparkModulePackView/>
								</DataTemplate>
							</ItemsRepeater.ItemTemplate>
						</ItemsRepeater>
					</ScrollViewer>
					<Grid>
						<TextBlock IsVisible="{Binding !HasModules}" MaxWidth="450" TextAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Text="You do not currently have any purchased modules.  Click 'Add Module' to purchase modules for this project"/>
					</Grid>
				</Grid>
			</Grid>

			<DockPanel Margin="0,13,0,0" Grid.Column="2"
					   HorizontalAlignment="Stretch"
					   VerticalAlignment="Top" >

				<Button Margin="3,3,5,3" DockPanel.Dock="Top"
										HorizontalAlignment="Stretch"
										Height="38" Width="165"
										VerticalContentAlignment="Center"
										Command="{Binding Back}" >
					<StackPanel Orientation="Horizontal">
						<material:MaterialIcon Width="24" Height="24" Foreground="SteelBlue" Kind="Backspace"></material:MaterialIcon>
						<TextBlock Margin="6,0" VerticalAlignment="Center" FontSize="13"  Text=" Return"/>
					</StackPanel>
				</Button>
				<Grid Margin="3,8,5,3" HorizontalAlignment="Stretch"  Background="Gainsboro" Width="165" DockPanel.Dock="Top"
						Height="1"/>

				<Button Margin="3,8,5,3" DockPanel.Dock="Top"
							IsEnabled="{Binding ParentViewModel.IsAdmin}"
							HorizontalAlignment="Stretch"
							Height="38" Width="165"
							VerticalContentAlignment="Center"
							Command="{Binding AddModule}" >
					<StackPanel Orientation="Horizontal">
						<material:MaterialIcon Width="24" Height="24" Foreground="SteelBlue" Kind="Plus"></material:MaterialIcon>
						<TextBlock Margin="6,0" VerticalAlignment="Center" FontSize="13"  Text="Add Module..."/>
					</StackPanel>
				</Button>				

				<Button Margin="3,3,5,3" IsVisible="False"
						HorizontalAlignment="Stretch"
						Height="38" Width="165" BorderBrush="SteelBlue"
						VerticalContentAlignment="Center"
						Command="{Binding ParentViewModel.Subscription.ShowSubscription}" >
					<StackPanel Orientation="Horizontal">
						<material:MaterialIcon Width="24" Height="24" Foreground="SteelBlue" Kind="Subscriptions"></material:MaterialIcon>
						<TextBlock Margin="6,0" VerticalAlignment="Center" FontSize="13"  Text="View Subscription"/>
					</StackPanel>
				</Button>
			</DockPanel>

		</Grid>
	</Border>
</UserControl>
