<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1024" d:DesignHeight="600"
			 xmlns:material="using:Material.Icons.Avalonia"
			 xmlns:CustomerTools="clr-namespace:Ahsoka.DeveloperTools.Views"
             x:Class="Ahsoka.DeveloperTools.Views.NewPackageView" Background="#33555555">
	<Border Margin="60" BoxShadow="5 5 10 2 DarkGray" BorderBrush="DarkGray" BorderThickness="1" Background="White">
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="*"/>
				<RowDefinition Height="60"/>
			</Grid.RowDefinitions>
			<Border BorderBrush="Gainsboro" BorderThickness="0,1,0,0" Grid.Row="1" Grid.Column="0" Grid.RowSpan="2"  Background="WhiteSmoke" VerticalAlignment="Stretch" Margin="0,0,0,0">

			</Border>
			<DockPanel Grid.RowSpan="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" LastChildFill="True"
					   IsVisible="{Binding IsCreate, FallbackValue=false}">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="*"/>
						<RowDefinition Height="60"/>
					</Grid.RowDefinitions>

					<Grid Grid.Row="1"
							   VerticalAlignment="Center"
							   HorizontalAlignment="Stretch">
						<Button HorizontalAlignment="Right"
								Height="38"
								VerticalContentAlignment="Center"
								Command="{Binding Next}" >
							<StackPanel Orientation="Horizontal">
								<material:MaterialIcon Width="24" Height="24" Foreground="SteelBlue" Kind="NextTitle"></material:MaterialIcon>
								<TextBlock Margin="6,0" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="13"  Text="  Next   "/>
							</StackPanel>
						</Button>
					</Grid>

					<Grid Margin="25" Grid.Row="0" RowDefinitions="25,*">
						<TextBlock FontSize="22" Text="Create New Project"/>
						<Border Grid.Row="1" Margin="10" Padding="3" BorderBrush="WhiteSmoke" BorderThickness="0,0,0,0">
							<DataGrid Name="FileList" SelectedItem="{Binding SelectedDemo}" BorderThickness="0" Margin="0,10,0,0" SelectionMode="Single"
								GridLinesVisibility="None"
								IsReadOnly="True"
								ItemsSource="{Binding Demos}" AutoGenerateColumns="False">
								<DataGrid.Columns>
									<DataGridTextColumn Header="Name" Binding="{Binding DisplayName}" />
									<DataGridTextColumn Header="Language" Binding="{Binding Language}" />
									<DataGridTextColumn Header="Description"  Binding="{Binding Description}" />
								</DataGrid.Columns>
							</DataGrid>
						</Border>
					</Grid>
				</Grid>
			</DockPanel>

			<DockPanel Grid.RowSpan="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" LastChildFill="True"
					   IsVisible="{Binding IsConfigure, FallbackValue=true}">
				<Grid >
					<Grid.RowDefinitions>
						<RowDefinition Height="*"/>
						<RowDefinition Height="60"/>
					</Grid.RowDefinitions>

					<Grid Grid.Row="1"
						   VerticalAlignment="Center"
						   HorizontalAlignment="Stretch">
						<Button HorizontalAlignment="Right"
								Height="38"
								VerticalContentAlignment="Center"
									Command="{Binding CreateProject}" >
							<StackPanel Orientation="Horizontal">
								<material:MaterialIcon Width="24" Height="24" Foreground="SteelBlue" Kind="Create"></material:MaterialIcon>
								<TextBlock Margin="6,0" VerticalAlignment="Center" FontSize="13"  Text="Create"/>
							</StackPanel>
						</Button>
						<Button  HorizontalAlignment="Left"
							Height="38" Margin="10"
							VerticalContentAlignment="Center"
								Command="{Binding Back}" >
							<StackPanel Orientation="Horizontal">
								<material:MaterialIcon Width="24" Height="24" Foreground="SteelBlue" Kind="ArrowLeft"></material:MaterialIcon>
								<TextBlock Margin="6,0" VerticalAlignment="Center" FontSize="13"  Text="Back"/>
							</StackPanel>
						</Button>
					</Grid>

					<StackPanel Margin="25" Grid.Row="0">
						<TextBlock FontSize="22" Text="Configure Project"/>
						<Grid Margin="20" ColumnDefinitions="150,Auto,Auto" RowDefinitions="*,*,*,*,*">
							<TextBlock Text="Project Name:"  VerticalAlignment="Center" Grid.Row="0" Grid.Column="0" />
							<TextBox Background="WhiteSmoke" IsReadOnly="true" HorizontalAlignment="Left" Margin="5" Text="{Binding ProjectName}" Grid.Row="0"  Width="250"  Grid.Column="1" TextWrapping="1"/>

							<TextBlock ToolTip.Tip="Path to where the project will be created." VerticalAlignment="Center"
								Text="Project Path:" Grid.Row="1" Grid.Column="0" />
							<Button  Margin="5,0"  Grid.Row="1" Grid.Column="2" Content="Choose Path..." Command="{Binding SetProjectDir}"/>
							<TextBox HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5" Text="{Binding ProjectPath}" Grid.Row="1"
									 Grid.Column="1"  Width="400" TextWrapping="1" IsReadOnly="True"/>

							<TextBlock Text="Folder Name:"  VerticalAlignment="Center" Grid.Row="2" Grid.Column="0"/>
							<StackPanel Orientation="Horizontal" Grid.Row="2" Grid.Column="1"  >
								<TextBox HorizontalAlignment="Left" VerticalAlignment="Center" 
										 Margin="5,5,15,5" Text="{Binding DirectoryName}"  Width="250"  Grid.Column="1" TextWrapping="1"/>
								<CheckBox IsChecked="{Binding MatchNames}"  />
								<TextBlock  Text="Match Names" FontSize="12" VerticalAlignment="Center"/>
							</StackPanel>

							<TextBlock Text="Selected Platform:"  VerticalAlignment="Center" Grid.Row="3" Grid.Column="0"/>
							<StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" Grid.Row="3" Grid.Column="1"  >
								<ComboBox ItemsSource="{Binding SelectedProjectList}"
											SelectedItem="{Binding SelectedProject}" BorderBrush="DimGray"
											HorizontalAlignment="Left"  VerticalAlignment="Center"
										 Margin="5"  Width="250"  Grid.Column="1" />
								<TextBlock TextWrapping="Wrap" Width="250" Margin="10,0"
										   Text="If more than one platform is included in the demo, select the one to launch."  
										   VerticalAlignment="Center" FontStyle="Italic" FontSize="12" Grid.Row="3" Grid.Column="0"/>
							</StackPanel>
						</Grid>
					</StackPanel>
				</Grid>

			</DockPanel>

		

			<Border IsVisible="{Binding ShowNoProjects, FallbackValue=false}" Grid.ColumnSpan="2" BorderThickness="0,0,0,0" Margin="0,0,0,0" >
				<Border  BoxShadow="5 5 10 2 DarkGray" Height="120" Width="450" Grid.ColumnSpan="2" BorderBrush="DarkGray" Background="White" BorderThickness="1">
					<Grid VerticalAlignment="Center">
						<TextBlock Foreground="SteelBlue" FontSize="16"
								   VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"  TextWrapping="Wrap"  Margin="0,0,0,45"
								   Padding="10" Text="No demo projects are available.  Go to the Plugin Manager to download demo projects."/>

						<Button Grid.Column="2" Grid.Row="0"
									HorizontalAlignment="Center"
									VerticalAlignment="Center" Margin="0,55,0,0"
									Command="{Binding GoToAddIns}" FontSize="10"
									Background="Transparent" Content="Go To Plugin Manager"/>
					</Grid>
				</Border>
			</Border>

			<Button Margin="4" Grid.Row="0" Width="24" Height="24"
				HorizontalAlignment="Right"
				VerticalAlignment="Top"
				Command="{Binding ClosePopup}"
				Background="Transparent">
				<material:MaterialIcon Padding="5"  Background="Transparent"
									   Foreground="SteelBlue" Kind="Close"/>
			</Button>
		</Grid>
	</Border>
</UserControl>
