<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:sys="clr-namespace:System;assembly=mscorlib"
			 xmlns:material="using:Material.Icons.Avalonia"
			 xmlns:progRing="clr-namespace:AvaloniaProgressRing;assembly=AvaloniaProgressRing"
			 mc:Ignorable="d" d:DesignWidth="850" d:DesignHeight="450" Background="#33555555"
             x:Class="Ahsoka.CustomerTools.Views.SparkProjectMemberListView" >

	<UserControl.Resources>
		<MenuFlyout x:Key="SharedMenuFlyout">
			<MenuItem Header="Project Administrator" Command="{Binding ChangeRoleAdmin}" 
					 FontSize="16" ToolTip.Tip="Admins have full control including adding and removing projects"/>
			<MenuItem Header="-" FontSize="16" />
			<MenuItem Header="Project Member" FontSize="16"  Command="{Binding ChangeRoleMember}" 
					 ToolTip.Tip="Members can manage modules, devices, application releases and artifacts" />
			<MenuItem Header="Project Viewer" FontSize="16"  Command="{Binding ChangeRoleViewer}" 
					  ToolTip.Tip="Viewers can view but not modify project information."/>
			<MenuItem Header="-" FontSize="16" />
			<MenuItem Header="Production Login" FontSize="16"  Command="{Binding ChangeRoleProduction}" 
					  ToolTip.Tip="Production Logins can view as well as add devices."/>
		</MenuFlyout>
	</UserControl.Resources>
	
	<Border Margin="20" BoxShadow="5 5 10 2 DarkGray" BorderBrush="DarkGray" BorderThickness="1" Background="White">
		<Grid Margin="10,10,0,10" ColumnDefinitions="*,220">
			<TextBlock FontSize="22" Grid.Row="0"  Text="{Binding ParentViewModel.TeamName, StringFormat='Project Members for {0}', FallbackValue='Project Members for None'}" />
			<DataGrid  Margin="0,45,10,0"
					   HorizontalAlignment="Stretch"
					   VerticalAlignment="Stretch"
					   ItemsSource="{Binding TeamMembers}"
					   SelectedItem="{Binding SelectedTeamMember}"
					   AutoGenerateColumns="False" >
				<DataGrid.Columns>
					<DataGridTextColumn Header="Member Name" Width="400" Binding="{Binding MemberEmailAddress}" IsReadOnly="True"/>
					<DataGridTextColumn Header="Project Role" Width="200" Binding="{Binding MemberRole}" IsReadOnly="True"/>
					<DataGridCheckBoxColumn Header="Is Owner" Binding="{Binding IsOwner}" IsReadOnly="True"/>
				</DataGrid.Columns>
			</DataGrid>

			<DockPanel Margin="0,13,0,0" Grid.Column="2"
					   HorizontalAlignment="Stretch"
					   VerticalAlignment="Top">
				<Button Margin="3,3,5,3" DockPanel.Dock="Top"
										HorizontalAlignment="Stretch"
										Height="38" Width="165"
										VerticalContentAlignment="Center"
										Command="{Binding Back}" >
					<StackPanel Orientation="Horizontal">
						<material:MaterialIcon Width="24" Height="24" Foreground="SteelBlue" Kind="Backspace"></material:MaterialIcon>
						<TextBlock Margin="6,0" VerticalAlignment="Center" FontSize="13"  Text=" Return"/>
					</StackPanel>
				</Button>

				<Grid Margin="3,8,5,3" HorizontalAlignment="Stretch"  Background="Gainsboro" Width="165" DockPanel.Dock="Top"
						Height="1"/>

				<StackPanel IsEnabled="{Binding IsAdmin}">

					<Button Margin="3,8,5,3" DockPanel.Dock="Top"
								IsEnabled="{Binding !ParentViewModel.IsViewer}"
								HorizontalAlignment="Stretch"
								Height="38" Width="165"
								VerticalContentAlignment="Center"
								Flyout="{StaticResource SharedMenuFlyout}" >
						<StackPanel Orientation="Horizontal">
							<material:MaterialIcon Width="24" Height="24" Foreground="SteelBlue" Kind="Administrator"></material:MaterialIcon>
							<TextBlock Margin="6,0" VerticalAlignment="Center" FontSize="13"  Text="Change Role"/>
						</StackPanel>
					</Button>

					<Button Margin="3,8,5,3" DockPanel.Dock="Top"
								IsEnabled="{Binding !ParentViewModel.IsViewer}"
								HorizontalAlignment="Stretch"
								Height="38" Width="165"
								VerticalContentAlignment="Center"
								Command="{Binding AddMember}" >
						<StackPanel Orientation="Horizontal">
							<material:MaterialIcon Width="24" Height="24" Foreground="SteelBlue" Kind="Plus"></material:MaterialIcon>
							<TextBlock Margin="6,0" VerticalAlignment="Center" FontSize="13"  Text="Add Member..."/>
						</StackPanel>
					</Button>
					<Button Margin="3,3,5,3" DockPanel.Dock="Top"
							IsEnabled="{Binding !ParentViewModel.IsViewer}"
							HorizontalAlignment="Stretch"
							Height="38" Width="165"
							VerticalContentAlignment="Center"
							Command="{Binding RemoveMember}" >
						<StackPanel Orientation="Horizontal">
							<material:MaterialIcon Width="24" Height="24" Foreground="SteelBlue" Kind="Minus"></material:MaterialIcon>
							<TextBlock Margin="6,0" VerticalAlignment="Center" FontSize="13"  Text="Remove Member"/>
						</StackPanel>
					</Button>
					<Grid DockPanel.Dock="Bottom">
						<TextBlock IsVisible="{Binding !ParentViewModel.ParentViewModel.IsError}" Margin="5,20" Width="180"
								   TextWrapping="Wrap" TextAlignment="Center"
								   HorizontalAlignment="Center" VerticalAlignment="Bottom"
								   Foreground="Black" FontSize="13"
								   Text="{Binding ParentViewModel.ParentViewModel.ResultText, FallbackValue='No Error'}"/>

						<TextBlock IsVisible="{Binding ParentViewModel.ParentViewModel.IsError}" Margin="5,20" Width="180" TextWrapping="Wrap"
								   HorizontalAlignment="Center" TextAlignment="Center"
								   Foreground="Red" FontSize="13" VerticalAlignment="Bottom"
								   Text="{Binding ParentViewModel.ParentViewModel.ResultText, FallbackValue='Error Found'}"/>
					</Grid>

				</StackPanel>
			</DockPanel>
		</Grid>
	</Border>
</UserControl>
