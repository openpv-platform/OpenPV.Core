<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<RootNamespace>Ahsoka</RootNamespace>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<DebugType>portable</DebugType>
		<AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
	</PropertyGroup>
	
	<ItemGroup>
		<None Include="LICENSE.txt" Pack="true" PackagePath="\" />
		<None Include="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<AdditionalFiles Include="..\..\Ahsoka.Proto\DataService.proto">
			<Link>Proto\%(RecursiveDir)%(Filename)%(Extension)</Link>
		</AdditionalFiles>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="protobuf-net" Version="3.2.30" />
		<PackageReference Include="protobuf-net.BuildTools" Version="3.2.33">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>

	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\Ahsoka.Core\Ahsoka.Core.csproj" />
	</ItemGroup>

	<!--To help Debugging since this is loaded dynamically-->
	<Target Name="AfterCanBuild" AfterTargets="Build" Condition="$(SolutionName)=='Ahsoka.Platform'">
		<Message Text="Copy CAN Extension..." Importance="high" />
		<Copy SourceFiles="$(SolutionDir)Ahsoka.Core.DataService\bin\$(Configuration)\$(TargetFramework)\Ahsoka.Core.DataService.dll" DestinationFiles="$(SolutionDir)..\\Extensions\Data Service Extension\lib\Ahsoka.Core.DataService.dll" />
		<Copy SourceFiles="$(SolutionDir)Ahsoka.Core.DataService\Ahsoka.Core.DataService.extensioninfo.json" DestinationFiles="$(SolutionDir)..\\Extensions\Data Service Extension\Ahsoka.Core.DataService.extensioninfo.json" />
	</Target>

	<ItemGroup>
		<PackageReference Include="GitVersion.MsBuild" Version="5.12.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>
	
</Project>
