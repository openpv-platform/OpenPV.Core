<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Avalonia.Svg.Skia"
		     xmlns:material="using:Material.Icons.Avalonia"
		     mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Ahsoka.DeveloperTools.Views.SparkLoginView" Background="#33555555">
	
	<Border Width="520" VerticalAlignment="Center"  BoxShadow="5 5 10 2 DarkGray" BorderBrush="DarkGray" BorderThickness="1" Background="White">
		<StackPanel>
			<Grid Margin="50,10" HorizontalAlignment="Center" VerticalAlignment="Center"  
				  ColumnDefinitions="Auto,Auto" 
				  RowDefinitions="*,*,*,*,*,90">
			
				<StackPanel Grid.ColumnSpan="2" Margin="10,30,10,30">
					<Image Margin="8"  Height="85" Name="svgSourceImage">
						<Image.Source>
							<svg:SvgImage Source="/Assets/OpenPV-Logo.svg" />
						</Image.Source>
					</Image>
					<TextBlock Margin="0,3" HorizontalAlignment="Center" VerticalAlignment="Bottom"
							    Foreground="Black"  Grid.Row="1" FontSize="11">Open PowerVision Toolkit by Enovation Controls Copyright 2022</TextBlock>
				</StackPanel>

				<ProgressBar VerticalAlignment="Top" Margin="0,10" MinHeight="2" 
						     IsIndeterminate="True" IsVisible="{Binding IsLoggingIn}"
							 Grid.Row="5" Grid.ColumnSpan="2"></ProgressBar>
				
				<TextBlock ToolTip.Tip="URL For Spark Services." VerticalAlignment="Center"
						   IsVisible="{Binding IsAdvanced}"
						 Text="Spark URL:" Grid.Row="1" Grid.Column="0"/>

				<ComboBox SelectedItem="{Binding SparkUrl}" ItemsSource="{Binding SparkUrlList}"
					 Grid.Row="1" Grid.Column="1" 
					 IsVisible="{Binding IsAdvanced}"
					 HorizontalAlignment="Left" Width="330"  Margin="5"/>

				<TextBlock ToolTip.Tip="Username for Spark LogIn." VerticalAlignment="Center"
							 Text="User Name:     " Grid.Row="2" Grid.Column="0"/>
				<TextBox Text="{Binding LoginName}"   Width="330" 
						 Grid.Row="2" Grid.Column="1"   HorizontalAlignment="Left"
						 TextWrapping="1" Margin="5"/>

				<TextBlock ToolTip.Tip="Password for Spark Login." VerticalAlignment="Center"
						 Text="Password:" Grid.Row="3" Grid.Column="0" />
				<TextBox Text="{Binding Password}"
						 Grid.Row="3" Grid.Column="1"  Width="200" 
						 HorizontalAlignment="Left" TextWrapping="1" Margin="5" PasswordChar="*"/>
				<CheckBox IsChecked="{Binding RememberMe}" Margin="0,0,5,0" Grid.Row="3" Grid.Column="2" HorizontalAlignment="Right"
						  Content="Save Login"></CheckBox>

				<StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="4">
					<Button  Classes="link" Margin="3,3,3,3"
						Height="24" FontStyle="Italic"
						VerticalContentAlignment="Center"
						Command="{Binding ForgotPassword}" 
						Foreground="SteelBlue" Background="White" 
						Content="Forgot Password?"	>
					</Button>
				</StackPanel>

							
				<StackPanel Orientation="Horizontal" Grid.Row="5"
							Grid.Column="0" Grid.ColumnSpan="2"
							HorizontalAlignment="Left">
			
					<Button Margin="5,3,125,3"
						HorizontalAlignment="Left"
						Height="32" 
						VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
						Command="{Binding SignUp}" 
						Content="Sign up for New Account">
					</Button>

					<Button Margin="3,3,5,3"
						HorizontalAlignment="Center"
						Height="32" Width="64"
						VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
						Command="{Binding LoginToSpark}" IsDefault="True"
						Background="SteelBlue"
						Foreground="White"
						Content="Login">
					</Button>

					<Button Margin="3,3,5,3"
						HorizontalAlignment="Center"
						Height="32" Width="64"
						VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
						Command="{Binding Cancel}"
						Content="Cancel">
					</Button>
				</StackPanel>
			</Grid>
			
		</StackPanel>
	</Border>
</UserControl>
