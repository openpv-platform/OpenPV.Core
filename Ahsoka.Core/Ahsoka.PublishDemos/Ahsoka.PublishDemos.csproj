<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<!--Disable Build Outputs-->
	<Target Name="Build" />
	<Target Name="Rebuild" />

	<PropertyGroup>
		<DemoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)..\..\..\'))</DemoRoot>
	</PropertyGroup>


	<Target Name="CreateDemos" AfterTargets="PostBuildEvent">

		<!-- Create Demo Packages -->
		<ItemGroup>
			<DEMO_Blank_Basic Include="$(DemoRoot)Ahsoka.Demo\Ahsoka.CS.Blank.Basic\**" />
			<DEMO_SERVICES Include="$(DemoRoot)Ahsoka.Demo\Ahsoka.CS.Services\**" />
			<DEMO_DRAWING Include="$(DemoRoot)Ahsoka.Demo\Ahsoka.CS.Drawing\**" />
			<DEMO_DEVICES Include="$(DemoRoot)Ahsoka.Demo\Ahsoka.CS.Devices\**" />
			<DEMO_BROWSER Include="$(DemoRoot)Ahsoka.Demo\Ahsoka.CS.Browser\**" />
		</ItemGroup>

		<Copy SourceFiles="@(DEMO_Blank_Basic)" DestinationFolder="$(DemoRoot)\BuildOutputs\Ahsoka.CS.Blank.Basic\%(RecursiveDir)" />
		<Copy SourceFiles="@(DEMO_SERVICES)" DestinationFolder="$(DemoRoot)\BuildOutputs\Ahsoka.CS.Services\%(RecursiveDir)" />
		<Copy SourceFiles="@(DEMO_DRAWING)" DestinationFolder="$(DemoRoot)\BuildOutputs\Ahsoka.CS.Drawing\%(RecursiveDir)" />
		<Copy SourceFiles="@(DEMO_DEVICES)" DestinationFolder="$(DemoRoot)\BuildOutputs\Ahsoka.CS.Devices\%(RecursiveDir)" />
		<Copy SourceFiles="@(DEMO_BROWSER)" DestinationFolder="$(DemoRoot)\BuildOutputs\Ahsoka.CS.Browser\%(RecursiveDir)" />

		<RemoveDir ContinueOnError="true" Directories="$(DemoRoot)\BuildOutputs\Ahsoka.CS.Blank.Basic\bin\" />
		<RemoveDir ContinueOnError="true" Directories="$(DemoRoot)\BuildOutputs\Ahsoka.CS.Blank.Basic\obj\" />
		<RemoveDir ContinueOnError="true" Directories="$(DemoRoot)\BuildOutputs\Ahsoka.CS.Blank.Basic\.vs\" />
		<ZipDirectory Overwrite="true" SourceDirectory="$(DemoRoot)BuildOutputs\Ahsoka.CS.Blank.Basic\" DestinationFile="$(DemoRoot)\SparkUpload\Ahsoka.CS.Blank.Basic.zip" />

		<RemoveDir ContinueOnError="true" Directories="$(DemoRoot)\BuildOutputs\Ahsoka.CS.Browser\bin\" />
		<RemoveDir ContinueOnError="true" Directories="$(DemoRoot)\BuildOutputs\Ahsoka.CS.Browser\obj\" />
		<RemoveDir ContinueOnError="true" Directories="$(DemoRoot)\BuildOutputs\Ahsoka.CS.Browser\.vs\" />
		<ZipDirectory Overwrite="true" SourceDirectory="$(DemoRoot)BuildOutputs\Ahsoka.CS.Browser\" DestinationFile="$(DemoRoot)\SparkUpload\Ahsoka.CS.Browser.zip" />

		<RemoveDir ContinueOnError="true" Directories="$(DemoRoot)\BuildOutputs\Ahsoka.CS.Drawing\bin\" />
		<RemoveDir ContinueOnError="true" Directories="$(DemoRoot)\BuildOutputs\Ahsoka.CS.Drawing\obj\" />
		<RemoveDir ContinueOnError="true" Directories="$(DemoRoot)\BuildOutputs\Ahsoka.CS.Drawing\.vs\" />
		<ZipDirectory Overwrite="true" SourceDirectory="$(DemoRoot)BuildOutputs\Ahsoka.CS.Drawing\" DestinationFile="$(DemoRoot)\SparkUpload\Ahsoka.CS.Drawing.zip" />

		<RemoveDir ContinueOnError="true" Directories="$(DemoRoot)\BuildOutputs\Ahsoka.CS.Devices\bin\" />
		<RemoveDir ContinueOnError="true" Directories="$(DemoRoot)\BuildOutputs\Ahsoka.CS.Devices\obj\" />
		<RemoveDir ContinueOnError="true" Directories="$(DemoRoot)\BuildOutputs\Ahsoka.CS.Devices\.vs\" />
		<ZipDirectory Overwrite="true" SourceDirectory="$(DemoRoot)BuildOutputs\Ahsoka.CS.Devices\" DestinationFile="$(DemoRoot)\SparkUpload\Ahsoka.CS.Devices.zip" />
		
		<RemoveDir ContinueOnError="true" Directories="$(DemoRoot)\BuildOutputs\Ahsoka.CS.Services\bin\" />
		<RemoveDir ContinueOnError="true" Directories="$(DemoRoot)\BuildOutputs\Ahsoka.CS.Services\obj\" />
		<RemoveDir ContinueOnError="true" Directories="$(DemoRoot)\BuildOutputs\Ahsoka.CS.Services\.vs\" />
		<ZipDirectory Overwrite="true" SourceDirectory="$(DemoRoot)BuildOutputs\Ahsoka.CS.Services\" DestinationFile="$(DemoRoot)\SparkUpload\Ahsoka.CS.Services.zip" />

		<ZipDirectory Overwrite="true" SourceDirectory="$(DemoRoot)Ahsoka.Demo\Ahsoka_QT_Demo" DestinationFile="$(DemoRoot)\SparkUpload\Ahsoka_QT_Demo.zip" />
		<ZipDirectory Overwrite="true" SourceDirectory="$(DemoRoot)Ahsoka.Demo\Ahsoka_QT_Blank" DestinationFile="$(DemoRoot)\SparkUpload\Ahsoka_QT_Blank.zip" />
		
		<!--Copy Spark Package Manifst to Output -->
		<Copy SourceFiles="OpenPV Demos.release.json" DestinationFiles="$(DemoRoot)\SparkUpload\OpenPV Demos.release.json" />
	</Target>

	<ItemGroup>
		<PackageReference Include="GitVersion.MsBuild" Version="[5.12.0]">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

</Project>
