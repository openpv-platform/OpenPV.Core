<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:material="using:Material.Icons.Avalonia"
	         mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="55"
             x:Class="Ahsoka.DeveloperTools.Views.ToolBar">
	<UserControl.Styles>
		<Style Selector="Grid#Rotate[IsVisible=true]">
			<Style.Animations>
				<Animation Duration="0:0:1" IterationCount="10">
					<KeyFrame Cue="100%">
						<Setter Property="RotateTransform.Angle" Value="360"/>
					</KeyFrame>
				</Animation>
			</Style.Animations>
		</Style>
	</UserControl.Styles>
	<Border Background="WhiteSmoke" Grid.ColumnSpan="2" BorderBrush="DarkGray" BorderThickness="0,0,0,1">
		<DockPanel>
			<Button MinWidth="56" Margin="8,3,3,3" Command="{Binding OpenNewPackage}" IsEnabled="{Binding LoggedIn}">
				<DockPanel>
					<StackPanel>
						<material:MaterialIcon Width="20" Height="20" Foreground="SteelBlue" Kind="PaperOutline"></material:MaterialIcon>
						<TextBlock HorizontalAlignment="Center" FontSize="11" Text="New..."/>
					</StackPanel>
				</DockPanel>
			</Button>

			<Button MinWidth="55" Command="{Binding OpenPackage}" Margin="3" IsEnabled="{Binding LoggedIn}">
				<StackPanel>
					<material:MaterialIcon Width="20" Height="20" Foreground="SteelBlue" Kind="FolderOpenOutline"></material:MaterialIcon>
					<TextBlock  HorizontalAlignment="Center" FontSize="11"  Text="Open..."/>
				</StackPanel>
			</Button>

			<Button Margin="3" IsVisible="{Binding SelectedPackage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" 
					MinWidth="55"  Command="{Binding SavePackage}">
				<StackPanel>
					<material:MaterialIcon Width="20" Height="20" Foreground="SteelBlue" Kind="FloppyDisc"></material:MaterialIcon>
					<TextBlock  HorizontalAlignment="Center" FontSize="11" Text="Save..."/>
				</StackPanel>
			</Button>

			<Button Margin="3,3,5,3" DockPanel.Dock="Right"   
					MinWidth="55" HorizontalAlignment="Right" 
					Command="{Binding ShowSparkUpdates}" 
					IsEnabled="{Binding !IsOffline}">
				<Grid>
					<StackPanel IsVisible="{Binding Updates.UpdateAvailable, FallbackValue=true}">
						<Grid Name="Rotate" >
							<material:MaterialIcon Width="20" Height="20" Foreground="DodgerBlue" ToolTip.Tip="Updates Available" Kind="Update"/>
						</Grid>
						<TextBlock HorizontalAlignment="Center" FontSize="11" ToolTip.Tip="Updates Available"  Text="Updates"/>
					</StackPanel>
					<StackPanel IsVisible="{Binding !Updates.UpdateAvailable, FallbackValue=false}">
						<material:MaterialIcon Width="20" Height="20" Foreground="SteelBlue" Kind="LightningBolt"></material:MaterialIcon>
						<TextBlock HorizontalAlignment="Center" FontSize="11"  Text="Updates"/>
					</StackPanel>
				</Grid>
			</Button>
			

			<Button Margin="3,3,5,3" DockPanel.Dock="Right"   MinWidth="55" 
					Command="{Binding ShowHelp}" >
				<StackPanel>
					<material:MaterialIcon Width="20" Height="20" Foreground="SteelBlue" Kind="HelpBox"></material:MaterialIcon>
					<TextBlock  HorizontalAlignment="Center" FontSize="11"  Text="Docs"/>
				</StackPanel>
			</Button>



			<Button Margin="3,3,5,3"
					IsVisible="{Binding SelectedPackage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
					MinWidth="55"
					Command="{Binding PromptSave}" >
				<StackPanel>
					<material:MaterialIcon Width="20" Height="20" Foreground="SteelBlue" Kind="CloseBox"></material:MaterialIcon>
					<TextBlock  HorizontalAlignment="Center" FontSize="11"  Text="Close"/>
				</StackPanel>
			</Button>


			<Button Margin="3,3,5,3" DockPanel.Dock="Right"   MinWidth="55" HorizontalAlignment="Right"
					Command="{Binding OpenOptions}" 
					IsEnabled="{Binding !IsOffline}">
				<StackPanel>
					<material:MaterialIcon Width="20" Height="20" Foreground="SteelBlue" Kind="Account"></material:MaterialIcon>
					<TextBlock  HorizontalAlignment="Center" FontSize="11"  Text="Account"/>
				</StackPanel>
			</Button>
			
	
			<Button Margin="3,3,5,3" DockPanel.Dock="Right"   MinWidth="55" HorizontalAlignment="Right" 
					Command="{Binding OpenTeams}" 
					IsEnabled="{Binding !IsOffline}">
				<StackPanel>
					<material:MaterialIcon Width="20" Height="20" Foreground="SteelBlue" Kind="Toolbox"></material:MaterialIcon>
					<TextBlock  HorizontalAlignment="Center" FontSize="11"  Text="Projects"/>
				</StackPanel>
			</Button>
			<Button Margin="3,3,15,3" DockPanel.Dock="Right"   MinWidth="55" HorizontalAlignment="Right" 
					Command="{Binding Connections.OpenSettings}" 
					IsEnabled="{Binding LoggedIn}">
				<StackPanel>
					<material:MaterialIcon Width="20" Height="20" Foreground="SteelBlue" Kind="Connection"></material:MaterialIcon>
					<TextBlock  HorizontalAlignment="Center" FontSize="11"  Text="Targets"/>
				</StackPanel>
			</Button>
			
			<Button DockPanel.Dock="Right" MinWidth="55" Margin="3,3,3,3" 
					Command="{Binding Plugins.OpenPopup}" 
					IsEnabled="{Binding !IsOffline}">
				<StackPanel>
					<material:MaterialIcon Width="20" Height="20" Foreground="SteelBlue" Kind="Extension"></material:MaterialIcon>
					<TextBlock  HorizontalAlignment="Center" FontSize="11"  Text="Plugins"/>
				</StackPanel>
			</Button>

			<Button Margin="3,3,15,3" 
					DockPanel.Dock="Right" HorizontalAlignment="Right"
					IsVisible="{Binding SelectedPackage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
					MinWidth="65"
					Command="{Binding SelectedPackage.LoadToTarget}" >
				<StackPanel>
					<material:MaterialIcon Width="20" Height="20" Foreground="SteelBlue" Kind="Download"></material:MaterialIcon>
					<TextBlock  HorizontalAlignment="Center" FontSize="11"  Text="Load"/>
				</StackPanel>
			</Button>

			<Button Margin="3,3,3,3" 
					DockPanel.Dock="Right" HorizontalAlignment="Right"
					IsVisible="{Binding SelectedPackage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
					MinWidth="65"
					Command="{Binding SelectedPackage.GenerateInstallPackage}" >
				<StackPanel>
					<material:MaterialIcon Width="20" Height="20" Foreground="SteelBlue" Kind="Webpack"></material:MaterialIcon>
					<TextBlock  HorizontalAlignment="Center" FontSize="11" Text="Generate"/>
				</StackPanel>
			</Button>	

			<Button Margin="3,3,15,3" DockPanel.Dock="Right"   
					MinWidth="55" HorizontalAlignment="Right" 
					Command="{Binding ToggleConsole}" >
				<StackPanel>
					<material:MaterialIcon Width="20" Height="20" Foreground="SteelBlue" Kind="Console"></material:MaterialIcon>
					<TextBlock  HorizontalAlignment="Center" FontSize="11"  Text="Console"/>
				</StackPanel>
			</Button>
			
		</DockPanel>
	</Border>

</UserControl>
