{
  "version": "4.0.1.10070",
  "applicationType": "dotnet",
  "execCommand": "Ahsoka.CS.Services",
  "packageName": "Ahsoka.CS.Services",
  "packageDescription": "Example of creating a Custom Ahsoka Service",
  "applicationVersion": "1.0",
  "packageApplicationFolder": "../Platform_OpenView/publish",
  "packageOutputDirectory": "PackageOutput",
  "licenses": [],
  "optimizedServiceManager": true,
  "customPackageInfo": {
    "includeApplication": false,
    "includeBootLogo": false,
    "includeInstallerUI": false,
    "includeFirmwareUpdate": false
  },
  "dotNetInfo": {
    "projectPath": "../Ahsoka.CS.Services.csproj",
    "publishProfile": "../Properties/PublishProfiles/LinuxProfile.pubxml"
  },
  "serviceInfo": {
    "runtimeConfiguration": {
      "serviceStartup": "noAutoStart",
      "releaseOption": "noAutoStart",
      "extensionInfo": [],
      "startupDelay": 3,
      "requireChallenge": "notRequired",
      "services": [
        {
          "socketType": "tcpSocket",
          "serviceName": "SystemService",
          "tcpListenAddress": "*",
          "tcpConnectionAddress": "localhost",
          "dataChannel": 5001,
          "isExtension": false,
          "behaviors": "autoStart"
        }
      ]
    },
    "environmentValues": []
  },
  "screenConfiguration": {
    "showUnknownSurfaces": false,
    "bootLogoPath": "",
    "orientation": "defaultOrientation",
    "surfaceSetups": []
  },
  "hardwareConfiguration": {
    "hardwareItems": [],
    "usbStartStatePrimary": "default",
    "usbStartStateSecondary": "default"
  },
  "packageType": "opvEncrypted",
  "packageStructureVersion": 1,
  "platformFamily": "openViewLinux",
  "platformQualifier": "S70",
  "securityMode": "none",
  "components": []
}