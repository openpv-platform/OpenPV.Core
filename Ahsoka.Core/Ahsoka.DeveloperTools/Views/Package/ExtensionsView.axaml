<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
           	  xmlns:progRing="clr-namespace:AvaloniaProgressRing;assembly=AvaloniaProgressRing"
		  	xmlns:sys="clr-namespace:System;assembly=mscorlib"
		     mc:Ignorable="d" d:DesignWidth="1085" d:DesignHeight="450"
             xmlns:material="using:Material.Icons.Avalonia"
             x:Class="Ahsoka.DeveloperTools.Views.ExtensionsView">

	<Grid HorizontalAlignment="Stretch" DataContext="{Binding SelectedPackage.ExtensionsViewModel}" >
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*"/>
			<ColumnDefinition Width="250"/>
		</Grid.ColumnDefinitions>

		<Grid.Styles>
			<StyleInclude Source="/Styles/UserInputStyles.axaml" />
		</Grid.Styles>

		<StackPanel Margin="-15" Grid.Column="1" 
			HorizontalAlignment="Center" VerticalAlignment="Stretch">
			<TextBlock FontSize="18"
				   VerticalAlignment="Top"
				   HorizontalAlignment="Center"
				   Margin="12"
				   Foreground="DimGray"
			   Text=" Service Actions "/>
			<Button Margin="3,3,5,3"
					HorizontalAlignment="Stretch"
					Height="38"
					VerticalContentAlignment="Center"
					Command="{Binding AddExtension}">
				<StackPanel Orientation="Horizontal">
					<material:MaterialIcon Width="24" Height="24" Foreground="SteelBlue" Kind="Plus"></material:MaterialIcon>
					<TextBlock Margin="6,0" VerticalAlignment="Center" FontSize="13"
							   ToolTip.Tip="Edit this Extension."
							   Text="Add an Extension..."/>
				</StackPanel>
			</Button>

			<Button Margin="3,3,5,3"
					HorizontalAlignment="Stretch"
					Height="38"
					VerticalContentAlignment="Center"
					Command="{Binding RemoveExtension}">
				<StackPanel Orientation="Horizontal">
					<material:MaterialIcon Width="24" Height="24" Foreground="SteelBlue" Kind="Minus"></material:MaterialIcon>
					<TextBlock Margin="6,0" VerticalAlignment="Center" FontSize="13"
							   ToolTip.Tip="Edit this Extension."
							   Text="Remove Extension..."/>
				</StackPanel>
			</Button>

			<Button Margin="3,13,5,3"
					HorizontalAlignment="Stretch"
					Height="38"
					IsEnabled="{Binding SelectedExtension.HasUx}"
					VerticalContentAlignment="Center"
					Command="{Binding SelectedExtension.ShowUx}">
				<StackPanel Orientation="Horizontal">
					<material:MaterialIcon Width="24" Height="24" Foreground="SteelBlue" Kind="ServiceToolbox"></material:MaterialIcon>
					<TextBlock Margin="6,0" VerticalAlignment="Center" FontSize="13"
							   ToolTip.Tip="Edit this Extension."
							   Text="Configure Extension..."/>
				</StackPanel>
			</Button>
			
			<CheckBox Foreground="DimGray" Margin="0,20" FontSize="12" IsChecked="{Binding PreRelease}" Content="Show Pre-Release Versions"/>
		</StackPanel>

		<Grid  ColumnDefinitions="205,auto,*" RowDefinitions="*,20">
			<Border BorderBrush="Gainsboro" BorderThickness="0"
					Margin="20,0"
					Grid.ColumnSpan="3" Grid.Row="0"
					HorizontalAlignment="Stretch">
				<Grid RowDefinitions="40,*,auto" ColumnDefinitions="*">
					<TextBlock Margin="20,10,10,-30" Text="Installed Extensions" FontSize="16"
							   TextWrapping="Wrap" Foreground="SteelBlue" HorizontalAlignment="Left"
							   Grid.Row="0" Grid.Column="2"/>
					<ProgressBar VerticalAlignment="Bottom" Margin="20,0,20,20" MinHeight="2"
						 IsIndeterminate="True" IsVisible="{Binding IsWorking}"
						 Grid.Row="1"  Grid.ColumnSpan="2"></ProgressBar>
					
					<Border Grid.ColumnSpan="3" Grid.Row="2" BorderBrush="Gainsboro"
							BorderThickness="1" Background="WhiteSmoke"
							Margin="20,0,20,20" Padding="10,10,10,10"
							HorizontalAlignment="Stretch">
						<TextBlock Grid.Row="2"  Text="Extensions are optional services and libraries you can add to your project to extend the Core OpenPV Functionality.  To download extensions, select the Extensions Plugin on the Plugin Tool."
							 FontSize="14" TextWrapping="Wrap"  FontStyle="Italic"
							 Foreground="SteelBlue" HorizontalAlignment="Left" />
					</Border>
					<Border VerticalAlignment="Stretch"
							Grid.Column="0" Grid.Row="1" BorderBrush="Gainsboro" BorderThickness="1"
							Margin="20,20,20,20" Padding="5">
						
						<ListBox IsEnabled="{Binding !IsWorking}" SelectedItem="{Binding SelectedExtension}"  ItemsSource="{Binding SelectedExtensions}" Background="Transparent" >
							<ListBox.ItemTemplate>
								<DataTemplate>
									<Grid Margin="-12" Background="#AAFFFFFF"  ClipToBounds="True">
										<Grid Margin="12,8,12,8" ColumnDefinitions="30,*,auto,auto,auto,auto" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

											<Grid Margin="0,3,0,0"
												  HorizontalAlignment="Left"
												  Height="24" >
												<material:MaterialIcon IsVisible="{Binding IsInstalled}" Width="20" Height="20" Foreground="SteelBlue" Kind="Check"></material:MaterialIcon>
												<material:MaterialIcon IsVisible="{Binding !IsInstalled}" Width="20" Height="20" Foreground="Gray" Kind="CloudOutline"></material:MaterialIcon>
											</Grid>
											<TextBlock Text="{Binding ExtensionName}" Margin="0,3,0,0"  HorizontalAlignment="Stretch" FontSize="14" Grid.Column="1" TextWrapping="1" />

											<Grid Margin="0,3,0,0" Grid.Column="2" RowDefinitions="auto,auto" ColumnDefinitions="85,250,100"
												  HorizontalAlignment="Right" >

												<TextBlock Text="Installed:"  Margin="0,3,13,0" VerticalAlignment="Center"  HorizontalAlignment="Left" FontSize="13" TextWrapping="1" />
												<Border Height="32" Margin="3" Padding="3" BorderBrush="Gray" 
														Background="WhiteSmoke" BorderThickness="1" Grid.Column="1">
													<TextBlock Margin="5,0,0,0" Text="{Binding InstalledVersion}" VerticalAlignment="Center"  HorizontalAlignment="Left" FontSize="13" TextWrapping="1" />
												</Border>

												<TextBlock Text="Available:"  Margin="0,3,13,0" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="13" TextWrapping="1" />
												<ComboBox Height="28" Grid.Row="1" Grid.Column="1" FontSize="12"
													  SelectedItem="{Binding AvailableVersion}" ItemsSource="{Binding AvailableVersions}"
												  HorizontalAlignment="Stretch" Margin="3"
													  HorizontalContentAlignment="Left" CornerRadius="0"
													  VerticalAlignment="Stretch" BorderBrush="Gray"/>


												<Button Margin="5" Grid.Row="1" Grid.Column="3"
													HorizontalAlignment="Center" Height="32"
													IsEnabled="{Binding !IsInstalled}"
													VerticalContentAlignment="Center"
													ToolTip.Tip="Check to add or exclude Optional Extensions from your Application."
													Command="{Binding UpdateExtension}">
													<Grid>
														<TextBlock Text="Installed"  IsVisible="{Binding IsInstalled}" Margin="0,0,0,0"  HorizontalAlignment="Stretch" FontSize="13" Grid.Column="1" TextWrapping="1" />
														<TextBlock Text="Update Extension" IsVisible="{Binding !IsInstalled}" Margin="0,0,0,0"  HorizontalAlignment="Stretch" FontSize="13" Grid.Column="1" TextWrapping="1" />
													</Grid>
												</Button>
											</Grid>
										</Grid>
									</Grid>
								</DataTemplate>
							</ListBox.ItemTemplate>
						</ListBox>
					</Border>
				</Grid>
			</Border>

		</Grid>
		<Grid IsVisible="{Binding AddExtensionsShown, FallbackValue=true}" IsEnabled="{Binding !IsWorking}"
					Grid.ColumnSpan="3" Grid.RowSpan="10" Background="#33FFFFFF">
			
			<Border Grid.Row="0" Grid.Column="2" BorderBrush="Gainsboro" BorderThickness="0"  Height="350" Width="650"  
					BoxShadow="5 5 10 2 DarkGray" 
					HorizontalAlignment="Stretch">
				<Grid RowDefinitions="40,*,auto"  ColumnDefinitions="*"  Background="White">
				<TextBlock Margin="20,10,10,-30" Text="Available Extensions" FontSize="16"
							   TextWrapping="Wrap" Foreground="SteelBlue" HorizontalAlignment="Left"/>
					<ProgressBar VerticalAlignment="Bottom" Margin="0,0" MinHeight="2"
						 IsIndeterminate="True" IsVisible="{Binding IsWorking}"
						 Grid.Row="5" Grid.ColumnSpan="2"></ProgressBar>
					<Border Grid.ColumnSpan="3" Grid.Row="2">
						
						<DockPanel  Margin="25,10,10,10"
								   HorizontalAlignment="Stretch" 
								   VerticalAlignment="Center">

							<Button DockPanel.Dock="Right"
									Height="38"
									VerticalContentAlignment="Center"
									Command="{Binding CancelAdd}">
								<StackPanel Orientation="Horizontal">
									<material:MaterialIcon Width="24" Height="24" Foreground="SteelBlue" Kind="Cancel"></material:MaterialIcon>
									<TextBlock Margin="6,0" VerticalAlignment="Center" FontSize="13"
											   ToolTip.Tip="Edit this Extension."
											   Text="Cancel"/>
								</StackPanel>
							</Button>
							<Button DockPanel.Dock="Right"
									Height="38"
									VerticalContentAlignment="Center"
									Command="{Binding AddExtensionContinued}">
								<StackPanel Orientation="Horizontal">
									<material:MaterialIcon Width="24" Height="24" Foreground="SteelBlue" Kind="ServiceToolbox"></material:MaterialIcon>
									<TextBlock Margin="6,0" VerticalAlignment="Center" FontSize="13"
											   ToolTip.Tip="Edit this Extension."
											   Text="Install Extension"/>
								</StackPanel>
							</Button>
							
							<CheckBox IsChecked="{Binding PreRelease}" DockPanel.Dock="Left" Foreground="SteelBlue">Include Pre-Release Extension Versions</CheckBox>

						</DockPanel>
					</Border>
					<Border VerticalAlignment="Stretch"
							Grid.Column="0" Grid.Row="1" BorderBrush="Gainsboro" BorderThickness="1"
							Margin="20,20,20,0" Padding="5">
						<ListBox SelectedItem="{Binding SelectedAvailableExtension}"  ItemsSource="{Binding AllExtensions}" Background="Transparent" >
							<ListBox.ItemTemplate>
								<DataTemplate>
									<Grid ColumnDefinitions="30,*,auto,auto,auto,auto" Margin="-5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
										<Grid Margin="0,3,0,0"
											   HorizontalAlignment="Left"
												 Height="24" >
											<material:MaterialIcon Width="20" Height="20" Foreground="Gray" Kind="CloudOutline"></material:MaterialIcon>
										</Grid>
										<TextBlock Text="{Binding ExtensionName}" Margin="0,3,0,0"  HorizontalAlignment="Stretch" FontSize="14" Grid.Column="1" TextWrapping="1" />
										<TextBlock Text="{Binding AvailableVersion, StringFormat='Available ({0})'}"  Margin="0,2,3,0"  HorizontalAlignment="Stretch" FontSize="11" Grid.Column="2" TextWrapping="1" />
									</Grid>
								</DataTemplate>
							</ListBox.ItemTemplate>
						</ListBox>
					</Border>

				</Grid>
			</Border>
		</Grid>
	</Grid>
	
</UserControl>

