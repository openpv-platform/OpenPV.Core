<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net7.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<!--Disable Build Outputs-->
	<Target Name="Build" />
	<Target Name="Rebuild" />

	<PropertyGroup>
		<CP_Source_Root>$([System.IO.Path]::GetFullPath('$(SolutionDir)..\'))</CP_Source_Root>
	</PropertyGroup>

	<Target Name="Clean Coprocessor Firmware" BeforeTargets="BeforeClean">
		<Message Text="Cleaning Coprocessor Firmware $(CP_Source_Root)" Importance="high" />
		<Delete Files="$(CP_Source_Root)\BuildOutputs\Firmware\OpenViewLinux_TargetSupport\firmware_CM4.elf" />
	</Target>

	<Target Name="BuildCoprocessorFirmware" AfterTargets="PostBuildEvent" Condition="!Exists('$(CP_Source_Root)\BuildOutputs\Firmware\OpenViewLinux_TargetSupport\firmware_CM4.elf')">
		
		<Message Text="Stopping Containers" Importance="high" />
		<Exec ContinueOnError="true" IgnoreExitCode="true" WorkingDirectory="$(CP_Source_Root)" Command="docker kill Ahsoka.CoProcessorBuilder" />
		
		<Message Text="Building CM4 Firmwware at $(CP_Source_Root)" Importance="high" />
		<Exec WorkingDirectory="$(CP_Source_Root)" Command="docker pull openpv/openview_cubeide" />
		<Exec Condition="'$(OS)' == 'Unix'" WorkingDirectory="$(InteropSource_Root)" Command="chmod +x $(CP_Source_Root)/Ahsoka.Coprocessor/openview_s/build_firmware.sh" />
		<Exec ContinueOnError="true" Timeout="300000" WorkingDirectory="$(CP_Source_Root)" Command="docker run -v $(CP_Source_Root):/workspaces --rm --entrypoint &quot;/workspaces/Ahsoka.Coprocessor/openview_s/build_firmware.sh&quot; --name Ahsoka.CoProcessorBuilder openpv/openview_cubeide" />
	</Target>

	<ItemGroup>
		<PackageReference Include="GitVersion.MsBuild" Version="5.12.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

</Project>
