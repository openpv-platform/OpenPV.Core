<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<AllowUnsafeBlocks>True</AllowUnsafeBlocks>
		<Platforms>AnyCPU;x64</Platforms>
		<TargetFramework>net8.0</TargetFramework>
		<RootNamespace>Ahsoka.Demo.Storyboard</RootNamespace>
	</PropertyGroup>

	<!--Beginning in OpenPV 3.0, Command Line Code Generators have been simplified and now execute as part of the 
	SDK Installation so the Targets File is no longer needed.  Its still referenced here for those that wish to continue 
	use the 2.x style Project Tooling-->
	<Import Label="Storyboard Build Properties and Build Targets" Project="Storyboard.Build.targets" Condition="false" />

	<ItemGroup Label="Reference to Ahsoka Nuget Packages" Condition="!Exists('../../Demo.Build.props')">
		<PackageReference Include="Ahsoka.Core" Version="(3.*,4.0)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Ahsoka.Core.Storyboard" Version="3.*-*" />
	</ItemGroup>
	
	<Import Label="Ahsoka Local Build Properties" Condition="Exists('../../Demo.Build.props')" Project="../../Demo.Build.props" />

	<!--Storyboard Runtimes to be included in the Package-->
	<PropertyGroup Label=" Storyboard Runtime Settings">
		<StoryboardProgramFolder>C:\Program Files\Crank_Software</StoryboardProgramFolder>
		<StoryboardVersion>8.1-stable.202402081352</StoryboardVersion>
	</PropertyGroup>

	<ItemGroup Label="Storyboard Runtimes and Application">

		<Content Label="Application Export" Include="StoryboardExport\**">
			<Visible>false</Visible>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>

		<Content Label="Windows Runtime" Include="$(StoryboardProgramFolder)\Storyboard_Engine\$(StoryboardVersion)\windows-x86_64-swrender-obj\**" Condition="'$(RuntimeIdentifier)' != 'linux-arm' and $([MSBuild]::IsOSPlatform('Windows'))">
			<Link>Storyboard/Windows64/sbengine/%(RecursiveDir)%(Filename)%(Extension)</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Visible>false</Visible>
		</Content>
		<Content Label="OpenView Runtime" Include="$(StoryboardProgramFolder)\Storyboard_Engine\$(StoryboardVersion)\linux-stmA5-armle-opengles_2.0-wayland-obj\**" Condition="'$(RuntimeIdentifier)' == 'linux-arm'">
			<Link>Storyboard/OpenViewLinux/sbengine/%(RecursiveDir)%(Filename)%(Extension)</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Visible>false</Visible>
		</Content>
		<Content Label="MacOS Runtime" Include="$(StoryboardProgramFolder)/Storyboard_Engine/$(StoryboardVersion)/macos-arm64-swrender-obj/**" Condition="'$(RuntimeIdentifier)' != 'linux-arm' and $([MSBuild]::IsOSPlatform('OSX'))">
			<Link>Storyboard/MacosArm64/sbengine/%(RecursiveDir)%(Filename)%(Extension)</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Visible>false</Visible>
		</Content>
	</ItemGroup>

</Project>
