<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:material="using:Material.Icons.Avalonia"
             x:Class="Ahsoka.DeveloperTools.Views.SparkChangePasswordView">

	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*"/>
			<ColumnDefinition Width="220"/>
		</Grid.ColumnDefinitions>

		<StackPanel Grid.Column="1"
					HorizontalAlignment="Center" >

			<Button Margin="3,27,5,3"
					HorizontalAlignment="Stretch"
					Height="38"
					VerticalContentAlignment="Center"
					Command="{Binding ChangePassword}" >
				<StackPanel Orientation="Horizontal">
					<material:MaterialIcon Width="24" Height="24" Foreground="SteelBlue" Kind="Update"></material:MaterialIcon>
					<TextBlock Margin="6,0" VerticalAlignment="Center" FontSize="13"  Text="Update Password"/>
				</StackPanel>
			</Button>

			<Button Margin="3,3,5,13"
					HorizontalAlignment="Stretch"
					Height="38"
					VerticalContentAlignment="Center"
					Command="{Binding Logout}" >
				<StackPanel Orientation="Horizontal">
					<material:MaterialIcon Width="24" Height="24" Foreground="SteelBlue" Kind="Logout"></material:MaterialIcon>
					<TextBlock Margin="6,0" VerticalAlignment="Center" FontSize="13"  Text="Logout"/>
				</StackPanel>
			</Button>
			
		</StackPanel>

		<StackPanel HorizontalAlignment="Left">
			<StackPanel.Styles>
				<StyleInclude Source="/Styles/UserInputStyles.axaml" />
			</StackPanel.Styles>
			<Border Margin="20,25,20,0" Padding="10" BorderBrush="WhiteSmoke" BorderThickness="0,0,0,0">
				<Grid HorizontalAlignment="Center" VerticalAlignment="Center" ColumnDefinitions="Auto,Auto,Auto" RowDefinitions="*,*,*,*,*">
					<TextBlock  VerticalAlignment="Center" Text="Old Password:" Grid.Row="0" Grid.Column="0"/>
					<TextBox Text="{Binding PasswordOld}" Grid.Row="0" Grid.Column="1"  Width="280" TextWrapping="1" Margin="5" PasswordChar="*"/>

					<TextBlock VerticalAlignment="Center" Text="New Password:" Grid.Row="1" Grid.Column="0"/>
					<TextBox Text="{Binding PasswordNew}" Grid.Row="1" Grid.Column="1"  Width="280" TextWrapping="1" Margin="5" PasswordChar="*"/>

					<TextBlock VerticalAlignment="Center" Text="Confirm New Password:" Grid.Row="2" Grid.Column="0"/>
					<TextBox Text="{Binding PasswordNewConfirmed}" Grid.Row="2" Grid.Column="1"  Width="280" TextWrapping="1" Margin="5" PasswordChar="*"/>
				</Grid>
			</Border>
		</StackPanel>
	</Grid>
</UserControl>