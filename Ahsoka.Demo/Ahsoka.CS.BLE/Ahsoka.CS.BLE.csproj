<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<AllowUnsafeBlocks>True</AllowUnsafeBlocks>
		<Platforms>AnyCPU;x64</Platforms>
		<TargetFramework>net7.0</TargetFramework>
	</PropertyGroup>
	
	<ItemGroup Label="Reference to Ahsoka Nuget Packages" Condition="!Exists('../../Demo.Build.props')">
		<PackageReference Include="Ahsoka.Core" Version="(2.*,3.0)" />
		<PackageReference Include="Ahsoka.Core.Drawing" Version="(2.*,3.0)" />
		<PackageReference Include="Ahsoka.Core.Bluetooth.LE" Version="(2.*,3.0)" />
	</ItemGroup>

	<Import Label="Ahsoka Local Build Properties" Condition="Exists('../../Demo.Build.props')" Project="../../Demo.Build.props" />

	<ItemGroup>
	  <None Update="Font.ttf">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </None>
	</ItemGroup>

</Project>
