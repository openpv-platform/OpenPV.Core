<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             xmlns:CustomerTools="clr-namespace:Ahsoka.DeveloperTools.Views"
             xmlns:material="using:Material.Icons.Avalonia" 
             x:Class="Ahsoka.DeveloperTools.Views.PackageInfoView">
		
	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*"/>
			<ColumnDefinition Width="250"/>
		</Grid.ColumnDefinitions>
		<StackPanel Margin="-15" Grid.Column="1"
					HorizontalAlignment="Center" >
			<TextBlock FontSize="18"
				   VerticalAlignment="Top"
				   HorizontalAlignment="Center"
				   Margin="12"
				   Foreground="DimGray"
				   Text="Package Actions "/>
			<Button Margin="3,3,5,3"
					HorizontalAlignment="Stretch"
					Height="38"
					IsVisible="{Binding SelectedPackage.IsOpenView}"
					VerticalContentAlignment="Center"
					Command="{Binding SelectedPackage.GenerateInstallPackage}" >
				<StackPanel Orientation="Horizontal">
					<material:MaterialIcon Width="24" Height="24" Foreground="SteelBlue" Kind="PackageVariantClosed"></material:MaterialIcon>
					<TextBlock Margin="6,0" VerticalAlignment="Center" FontSize="13"  Text="Generate Package"/>
				</StackPanel>
			</Button>
		
			<Button Margin="3,3,5,3"
					HorizontalAlignment="Stretch"
					Height="38"
					VerticalContentAlignment="Center"
					Command="{Binding SelectedPackage.LoadToTarget}" >
				<StackPanel Orientation="Horizontal">
					<material:MaterialIcon Width="24" Height="24" Foreground="SteelBlue" Kind="Download"></material:MaterialIcon>
					<TextBlock Margin="6,0" VerticalAlignment="Center" FontSize="13"  Text="Load To Target"/>
				</StackPanel>
			</Button>

			<Button Margin="3,13,5,3"
				HorizontalAlignment="Stretch"
				Height="38"
				VerticalContentAlignment="Center"
				Command="{Binding SelectedPackage.ShowCustomPackage}">
				<StackPanel Orientation="Horizontal">
					<material:MaterialIcon Width="24" Height="24" Foreground="SteelBlue" Kind="PackageVariant"></material:MaterialIcon>
					<TextBlock Margin="6,0" VerticalAlignment="Center" FontSize="13"  Text="Create Custom"/>
				</StackPanel>
			</Button>

			<Button Margin="3,3,5,3"
				HorizontalAlignment="Stretch"
				Height="38"
				VerticalContentAlignment="Center"
				Command="{Binding SelectedPackage.LoadToTargetCustom}">
				<StackPanel Orientation="Horizontal">
					<material:MaterialIcon Width="24" Height="24" Foreground="SteelBlue" Kind="DownloadOutline"></material:MaterialIcon>
					<TextBlock Margin="6,0" VerticalAlignment="Center" FontSize="13"  Text="Load Custom "/>
				</StackPanel>
			</Button>
			<TextBlock FontSize="18"
			   VerticalAlignment="Top"
			   HorizontalAlignment="Center"
			   Margin="12"
			   Foreground="DimGray"
			   Text="Provisioning"
			   Grid.Column="1"/>

			<Button Margin="3,3,5,3"
							HorizontalAlignment="Stretch"
							Height="38"
							VerticalContentAlignment="Center"
							Command="{Binding SelectedPackage.SparkViewModel.ProvisionDisplay}"
							ToolTip.Tip="Provision Display for OTA and Other Software Modules.">
				<Button.IsEnabled>
					<MultiBinding Converter="{x:Static BoolConverters.And}">
						<Binding Path="ActiveConnection.IsConnected"/>
						<Binding Path="!IsOffline"/>
					</MultiBinding>
				</Button.IsEnabled>
				<StackPanel Orientation="Horizontal">
					<material:MaterialIcon Width="24" Height="24" Foreground="SteelBlue" Kind="License"></material:MaterialIcon>
					<TextBlock Margin="6,0" VerticalAlignment="Center" FontSize="13"  Text="License Target"/>
				</StackPanel>
			</Button>

			<Button Margin="3,3,5,3"
					HorizontalAlignment="Stretch"
					Height="38"
					VerticalContentAlignment="Center"
					IsEnabled="{Binding !IsOffline}"
					Command="{Binding SelectedPackage.SparkViewModel.UploadToSpark}">
				<StackPanel Orientation="Horizontal">
					<material:MaterialIcon Width="24" Height="24" Foreground="SteelBlue" Kind="Upload"></material:MaterialIcon>
					<TextBlock Margin="6,0" VerticalAlignment="Center" FontSize="13"  Text="Upload To Spark"/>
				</StackPanel>
			</Button>


			<TextBlock FontSize="18"
				   VerticalAlignment="Top"
				   HorizontalAlignment="Center"
				   Margin="12,24,12,12"
				   Foreground="DimGray"
				   Text="Developer Actions "
				   Grid.Column="1"/>
			<Button Margin="3,3,5,3"
					HorizontalAlignment="Stretch"
					Height="38"
					VerticalContentAlignment="Center"
					IsEnabled="{Binding SelectedPackage.IsLaunchCompatible}"
					Command="{Binding SelectedPackage.LaunchDevTool}" >
				<StackPanel Orientation="Horizontal">
					<material:MaterialIcon Width="24" Height="24" Foreground="SteelBlue" Kind="Launch"></material:MaterialIcon>
					<TextBlock Margin="6,0" VerticalAlignment="Center" FontSize="13"  Text="Launch Project"/>
				</StackPanel>
			</Button>

		</StackPanel>
		<ScrollViewer>
			<StackPanel DataContext="{Binding SelectedPackage}" HorizontalAlignment="Stretch" >
				<StackPanel.Styles>
					<StyleInclude Source="/Styles/UserInputStyles.axaml" />
				</StackPanel.Styles>

				<Border Margin="20,20,20,0" Padding="3"  BorderThickness="0,0,0,1">
					<Grid Margin="5" ColumnDefinitions="150,Auto,25,125,Auto" RowDefinitions="36,56,36,*">
						<TextBlock TabIndex="0" Text="Package Name:" Grid.Row="0" Grid.Column="0"/>
						<TextBox Text="{Binding PackageName, FallbackValue=PackageName}" Grid.Row="0"  Width="250"  Grid.Column="1" TextWrapping="1"/>

						<TextBlock TabIndex="0" Text="Package Description:"  Grid.Row="1" VerticalAlignment="Top" Margin="4,8" Grid.Column="0"/>
						<TextBox Text="{Binding PackageDescription, FallbackValue=PackageDescription}" 
								 Grid.Row="1"  Width="450" Height="56" Grid.Column="1" TextWrapping="1"/>

						<TextBlock Text="Target Platform:" Grid.Row="2" Grid.Column="0"/>
						<ComboBox  Grid.Row="2" Grid.Column="1" SelectedItem="{Binding PlatformDescription}"
								   ItemsSource="{Binding PlatformDescriptions}"  Width="250" />

						<TextBlock IsVisible="False" Text="Package Type:" Grid.Row="3" Grid.Column="0"/>
						<ComboBox IsVisible="False" Grid.Row="3"  Grid.Column="1" SelectedItem="{Binding PackageType}"
								   ItemsSource="{Binding PackageTypes}"  Width="250" />

						<TextBlock TabIndex="0" Text="Application Version:" Grid.Row="4" Grid.Column="0"/>
						<TextBox Text="{Binding ApplicationVersion, FallbackValue=1.0}" Grid.Row="4"  Width="250"  Grid.Column="1" TextWrapping="1"/>

					

					</Grid>
				</Border>
			
				<Border IsVisible="{Binding IsOpenView}"
					 Margin="20,10,20,0" Padding="3" BorderBrush="WhiteSmoke" BorderThickness="0,1,0,1">
					<Grid Margin="5,15,5,10" ColumnDefinitions="150,Auto,Auto" RowDefinitions="auto,36,36,36,auto,auto,auto">

						<TextBlock  ToolTip.Tip="Path where your development tool outputs your application files."
								 Text="Application Output:" Grid.Row="1" Grid.Column="0"/>
						<Button  Margin="5,0"  Grid.Row="1" Grid.Column="2" Content="Choose Path..." Command="{Binding SetApplicationDir}"/>
						<TextBox Text="{Binding PackageApplicationFolder}" Grid.Row="1" Grid.Column="1"  Width="280" TextWrapping="1" IsReadOnly="True"/>

						<TextBlock Text="Package Output:"
								   ToolTip.Tip="Path where the Generate process will create your output (opv) files."
								   Grid.Row="2" Grid.Column="0"/>
						<Button Margin="5,0" Grid.Row="2" Grid.Column="2" Content="Choose Path..." Command="{Binding SetOutputDir}"/>
						<TextBox Text="{Binding PackageOutputDirectory}" Grid.Row="2" Grid.Column="1" Width="280" TextWrapping="1"  IsReadOnly="True"/>

						<TextBlock Text="Execute Command:" Grid.Row="3" Grid.Column="0"/>
						<TextBox Text="{Binding ExecCommand}" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="4" Width="325" TextWrapping="1" />

						<TextBlock IsVisible="{Binding IsOpenView}" Text="Optimize Services:" Grid.Row="4" Margin="5,10" Grid.Column="0"/>
						<StackPanel Orientation="Horizontal" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3">
							<CheckBox IsEnabled="{Binding SupportsOptimized}" IsVisible="{Binding IsOpenView}" 
									  IsChecked="{Binding GenerateOptimizedServiceManager}" ToolTip.Tip="Currently only supported on Windows Compiles" />
							<TextBlock IsVisible="{Binding IsOpenView}" FontStyle="Italic" Foreground="DimGray" 
									   Text="Generates an optimized service manager executable (requires SDK)"
									   ToolTip.Tip="Compiles an optimized executable which includes your extensions. This improves boot times and performance of services however you should disable this option if you need to remotely debug services"/>
						</StackPanel>
					
					</Grid>
				</Border>

				<Border Margin="20,10,20,0" Padding="3" BorderBrush="WhiteSmoke" BorderThickness="0,0,0,0">
					<Grid Margin="5" ColumnDefinitions="150,Auto" RowDefinitions="*,*,auto">
						<TextBlock Text="Provisioning Project:"  Grid.Column="0"/>
						<StackPanel Orientation="Horizontal" Grid.Column="1" Grid.ColumnSpan="3" HorizontalAlignment="Left" >
							<ComboBox  SelectedItem="{Binding SparkViewModel.SelectedTeam}" ItemsSource="{Binding SparkViewModel.OTATeamsList}" Grid.Row="4" Grid.Column="1" Width="250"  />
							<TextBlock Text="(Used for Licensing and OTA)" Grid.Row="1" Grid.Column="0"/>
						</StackPanel>
						<TextBlock  Margin="3,0,0,20" Text="Signing Key:" Grid.Row="1"  Grid.Column="0"/>
						<StackPanel Margin="0,0,0,20" Orientation="Horizontal" Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="3" HorizontalAlignment="Left" >
							<ComboBox  SelectedItem="{Binding SparkViewModel.SelectedCert}" ItemsSource="{Binding SparkViewModel.AvailableCerts}" Grid.Row="4" Grid.Column="1" Width="250"  />
							<TextBlock Text="(Key to be used when signing the opv package)" ToolTip.Tip="This feature requires that the display was prepped or locked with the signing key." Grid.Row="1" Grid.Column="0"/>
						</StackPanel>

						<TextBlock IsVisible="{Binding SparkViewModel.HasModules}" Text="Licensed Modules:" VerticalAlignment="Top" Margin="5,8" Grid.Column="0" Grid.Row="2"/>
						<ItemsRepeater IsVisible="{Binding SparkViewModel.HasModules}" Grid.Row="2" Grid.Column="1" Width="450" VerticalAlignment="Stretch" HorizontalAlignment="Left"
									   ItemsSource="{Binding SparkViewModel.AvailableModules}">
							<ItemsRepeater.Layout>
								<StackLayout Spacing="0" Orientation="Vertical"/>
							</ItemsRepeater.Layout>
							<ItemsRepeater.ItemTemplate>
								<DataTemplate>
									<Grid ColumnDefinitions="*">
										<CheckBox Background="White" Margin="0,3"
												  VerticalAlignment="Top" IsChecked="{Binding IsSelected}"
												  Content="{Binding ModuleName, StringFormat='Require License for {0}' FallbackValue='Require License For None'}"/>
									</Grid>
								</DataTemplate>
							</ItemsRepeater.ItemTemplate>
						</ItemsRepeater>
					</Grid>
				</Border>
			
			</StackPanel>
		</ScrollViewer>

		<Border Margin="0,-50,0,0" Background="#00555555" 
				IsVisible="{Binding SelectedPackage.CustomShown, FallbackValue=false}" Grid.ColumnSpan="2"  BorderThickness="0,0,0,0" >
			<Border  BoxShadow="5 5 10 2 DarkGray" HorizontalAlignment="Center" VerticalAlignment="Center"
					 BorderBrush="DarkGray" Background="White" BorderThickness="1">
				<Grid Margin="50" ColumnDefinitions="150,Auto,Auto" RowDefinitions="*,*,*,*,*,*,">
					<TextBlock Text="Custom Install Components  "
							   ToolTip.Tip="Custom Installs allow you to create installs which include optional features or exclude normally installed features." Background="White" Margin="-10,-30"  FontSize="15"
							   Foreground="SteelBlue" Grid.Row="0" Grid.ColumnSpan="3" HorizontalAlignment="Left"  Grid.Column="0"/>

					<TextBlock IsVisible="{Binding IsOpenView}" Text="Update Application:" Grid.Row="1" Margin="5,10" Grid.Column="0"/>
					<StackPanel Orientation="Horizontal" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3">
						<CheckBox IsVisible="{Binding IsOpenView}" IsChecked="{Binding SelectedPackage.IncludeAppComponents}"/>
						<TextBlock VerticalAlignment="Center" IsVisible="{Binding SelectedPackage.IsOpenView}" FontStyle="Italic" Foreground="DimGray"
								   Text="Adds All Application Components (Installer, App, Extensions)."
								   ToolTip.Tip="Checking this checkbox creates a standard install package with only the Application Updaters."/>
					</StackPanel>
					<TextBlock IsVisible="{Binding IsOpenView}" Text="Update Installer UI:" Grid.Row="2" Margin="5,10" Grid.Column="0"/>
					<StackPanel Orientation="Horizontal" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3">
						<CheckBox IsVisible="{Binding IsOpenView}" IsChecked="{Binding SelectedPackage.IncludeInstallerUI}" />
						<TextBlock VerticalAlignment="Center" IsVisible="{Binding SelectedPackage.IsOpenView}" FontStyle="Italic" Foreground="DimGray"
								   Text="Adds a component to updates the Installer UI on the Target" />
					</StackPanel>
					<TextBlock IsVisible="{Binding IsOpenView}" Text="Update Firmware:" Grid.Row="3" Margin="5,10" Grid.Column="0"/>
					<StackPanel Orientation="Horizontal" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3">
						<CheckBox IsVisible="{Binding IsOpenView}" IsChecked="{Binding SelectedPackage.IncludeFirmwareUpdate}"/>
						<TextBlock VerticalAlignment="Center" IsVisible="{Binding SelectedPackage.IsOpenView}" FontStyle="Italic" Foreground="DimGray"
								   Text="Adds a delta Firmware Upgrader Component to the installer."
								   ToolTip.Tip="Adds a delta upgrader component to your install package which upgrades the base image.  This does increase install times as well as require a reboot as part of the install process."/>
					</StackPanel>
					<TextBlock IsVisible="{Binding IsOpenView}" Text="Update Boot Logo:" Grid.Row="4" Margin="5,10" Grid.Column="0"/>
					<StackPanel Orientation="Horizontal"
								Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3">
						<CheckBox IsVisible="{Binding IsOpenView}" IsChecked="{Binding SelectedPackage.IncludeBootLogo}"/>
						<TextBlock VerticalAlignment="Center" IsVisible="{Binding SelectedPackage.IsOpenView}" FontStyle="Italic" Foreground="DimGray"
								   Text="Updates the Boot Logo"
								   ToolTip.Tip="Boot logos are always included in the default Application but can be excluded from custom packages."/>
					</StackPanel>
					<StackPanel Margin="0,20,-30,-30" Grid.Row="5" Grid.Column="3" HorizontalAlignment="Right"
								 Grid.ColumnSpan="2" Orientation="Horizontal">
						<Button
								Margin="10,0,0,0"
								HorizontalAlignment="Right"
								Height="38"
								VerticalContentAlignment="Center"
								Command="{Binding SelectedPackage.GenerateCustomPackage}">
							<StackPanel Orientation="Horizontal">
								<material:MaterialIcon Width="24" Height="24" Foreground="SteelBlue" Kind="PackageVariantClosed"></material:MaterialIcon>
								<TextBlock Margin="6,0" VerticalAlignment="Center" FontSize="13"  Text="Generate Package"/>
							</StackPanel>
						</Button>
						<Button Margin="10,0,0,0"
								HorizontalAlignment="Right"
								Height="38"
								VerticalContentAlignment="Center"
								Command="{Binding SelectedPackage.CancelCustom}">
							<StackPanel Orientation="Horizontal">
								<material:MaterialIcon Width="24" Height="24" Foreground="SteelBlue" Kind="Cancel"></material:MaterialIcon>
								<TextBlock Margin="6,0" VerticalAlignment="Center" FontSize="13"  Text="Cancel Generation"/>
							</StackPanel>
						</Button>
					</StackPanel>
				</Grid>
			</Border>
		</Border>


	</Grid>
</UserControl>

