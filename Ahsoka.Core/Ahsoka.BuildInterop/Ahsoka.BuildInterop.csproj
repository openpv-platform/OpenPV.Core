<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<!--Disable Build Outputs-->
	<Target Name="Build" />
	<Target Name="Rebuild" />

	<PropertyGroup>
		<InteropSource_Root>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)..\..\..\'))</InteropSource_Root>
	</PropertyGroup>

	<Target Name="Clean BuildOutputs" BeforeTargets="BeforeClean">
		<Message Text="Cleaning BuildOutputs" Importance="high" />
		<RemoveDir Directories="$(InteropSource_Root)\BuildOutputs\Ahsoka.Services" />
		<RemoveDir Directories="$(InteropSource_Root)\BuildOutputs\SDK" />
		<RemoveDir Directories="$(InteropSource_Root)\BuildOutputs\StoryboardLib" />
	</Target>
	
	<Target Name="BuildInteropLibs" AfterTargets="PostBuildEvent" Condition="!Exists('$(InteropSource_Root)\BuildOutputs\Ahsoka.Services\Ahsoka.Services.OpenViewLinux.so')">

		<Message Text="Stopping Containers" Importance="high" />
		<Exec ContinueOnError="true" IgnoreExitCode="true" WorkingDirectory="$(InteropSource_Root)" Command="docker kill Ahsoka.CoreBuilder" />
		<Exec ContinueOnError="true" IgnoreExitCode="true" WorkingDirectory="$(InteropSource_Root)" Command="docker kill Ahsoka.CoreBuilderPro" />

		<Message Text="Building OpenView Interop Libraries at $(InteropSource_Root)" Importance="high" />
		<Exec Condition="true" WorkingDirectory="$(InteropSource_Root)" Command="docker pull openpv/openview_sdk_3_0" />
		<Exec Condition="'$(OS)' == 'Unix'" WorkingDirectory="$(InteropSource_Root)" Command="chmod +x $(InteropSource_Root)/Ahsoka.Interop/build_setup.sh" />
		<Exec Timeout="300000" WorkingDirectory="$(InteropSource_Root)" Command="docker run -e OPENPV_VERSION=$(GitVersion_FullSemVer) -v $(InteropSource_Root):/source --rm --entrypoint &quot;/source/Ahsoka.Interop/build_setup.sh&quot; --name Ahsoka.CoreBuilder openpv/openview_sdk_3_0" />
		
		
		<Message Text="Building OpenViewPro Interop Libraries at $(InteropSource_Root)" Importance="high" />
		<Exec Condition="true" WorkingDirectory="$(InteropSource_Root)" Command="docker pull openpv/openviewpro_sdk_3_0" />
		<Exec Condition="'$(OS)' == 'Unix'" WorkingDirectory="$(InteropSource_Root)" Command="chmod +x $(InteropSource_Root)/Ahsoka.Interop/build_setup_pro.sh" />
		<Exec Timeout="300000" WorkingDirectory="$(InteropSource_Root)" Command="docker run -e OPENPV_VERSION=$(GitVersion_FullSemVer) -v $(InteropSource_Root):/source --rm --entrypoint &quot;/source/Ahsoka.Interop/build_setup_pro.sh&quot; --name Ahsoka.CoreBuilderPro openpv/openviewpro_sdk_3_0" />

	</Target>
	
	<ItemGroup>
	  <None Include="..\..\Ahsoka.Interop\Build_CPP_SDK.bat" Link="Build_CPP_SDK.bat" />
	  <None Include="..\..\Ahsoka.Interop\Build_CPP_SDK.sh" Link="Build_CPP_SDK.sh" />
	  <None Include="..\..\Ahsoka.Interop\Build_CPP_SDK_PRO.sh" Link="Build_CPP_SDK_PRO.sh" />
	  <None Include="..\..\Ahsoka.Interop\build_setup.sh" Link="build_setup.sh" />
	  <None Include="..\..\Ahsoka.Interop\build_setup_pro.sh" Link="build_setup_pro.sh" />
	</ItemGroup>


	<ItemGroup>
		<PackageReference Include="GitVersion.MsBuild" Version="5.12.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

</Project>
