<Project Sdk="Microsoft.NET.Sdk">
	
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<AllowUnsafeBlocks>True</AllowUnsafeBlocks>
		<Platforms>AnyCPU;x64</Platforms>
		<TargetFramework>net7.0</TargetFramework>
		<RootNamespace>Ahsoka.Demo.Storyboard</RootNamespace>
	</PropertyGroup>

	<!--Beginning in OpenPV 3.0, Command Line Code Generators have been simplified and now execute as part of the 
	SDK Installation so the Targets File is no longer needed.  Its still referenced here for those that wish to continue 
	use the 2.x style Project Tooling-->
	<Import Label="Storyboard Build Properties and Build Targets" Project="Storyboard.Build.targets" Condition="false" />
	
	<ItemGroup Label="Reference to Ahsoka Nuget Packages" Condition="!Exists('../../Demo.Build.props')">
		<PackageReference Include="Ahsoka.Core" Version="(3.*,4.0)" />
		<PackageReference Include="Ahsoka.Core.Storyboard" Version="(3.*,4.0)" />
	</ItemGroup>

	<Import Label="Ahsoka Local Build Properties" Condition="Exists('../../Demo.Build.props')" Project="../../Demo.Build.props" />
	
</Project>
