<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<!--Disable Build Outputs-->
	<Target Name="Build" />
	<Target Name="Rebuild" />

	<PropertyGroup>
		<InteropSource_Root>$([System.IO.Path]::GetFullPath('$(SolutionDir)..\'))</InteropSource_Root>
	</PropertyGroup>

	<Target Name="Clean BuildOutputs" BeforeTargets="BeforeClean">
		<Message Text="Cleaning BuildOutputs" Importance="high" />
		<RemoveDir Directories="$(InteropSource_Root)\BuildOutputs\Ahsoka.Services" />
		<RemoveDir Directories="$(InteropSource_Root)\BuildOutputs\SDK" />
		<RemoveDir Directories="$(InteropSource_Root)\BuildOutputs\StoryboardLib" />
	</Target>
	
	<Target Name="BuildInteropLibs" AfterTargets="PostBuildEvent" Condition="!Exists('$(InteropSource_Root)\BuildOutputs\Ahsoka.Services\Ahsoka.Services.ST.so')">

		<Message Text="Stopping Containers" Importance="high" />
		<Exec ContinueOnError="true" IgnoreExitCode="true" WorkingDirectory="$(InteropSource_Root)" Command="docker kill Ahsoka.CoreBuilder" />

		<Message Text="Building Linux Interop Libraries at $(InteropSource_Root)" Importance="high" />
		<Exec WorkingDirectory="$(InteropSource_Root)" Command="docker pull openpv/openview_sdk_2_0" />
		<Exec Condition="'$(OS)' == 'Unix'" WorkingDirectory="$(InteropSource_Root)" Command="chmod +x $(InteropSource_Root)/Ahsoka.Interop/build_setup.sh" />
		<Exec Timeout="300000" WorkingDirectory="$(InteropSource_Root)" Command="docker run -e OPENPV_VERSION=$(GitVersion_FullSemVer) -v $(InteropSource_Root):/source --rm --entrypoint &quot;/source/Ahsoka.Interop/build_setup.sh&quot; --name Ahsoka.CoreBuilder openpv/openview_sdk_2_0" />

		<Message Condition="false" Text="Building Windows Libraries" Importance="high" />
		<Exec Condition="false" Command="$(InteropSource_Root)/Ahsoka.Interop/Build_CPP_SDK.bat" />
	</Target>

	<ItemGroup>
		<PackageReference Include="GitVersion.MsBuild" Version="5.12.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

</Project>
