<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<!--Disable Build Outputs-->
	<Target Name="Build" />
	<Target Name="Rebuild" />

	<Import Project="../Ahsoka.DownloadBSP/BSP.Targets" />

	<PropertyGroup>
		<PlatformSupportRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)..\..\..\'))</PlatformSupportRoot>
	</PropertyGroup>

	<Target Name="Clean BuildOutputs" BeforeTargets="BeforeClean">
		<Message Text="Cleaning OpenView BuildOutputs" Importance="high" />
		<RemoveDir Directories="$(PlatformSupportRoot)\PlatformSupport\OpenViewLinux_TargetSupport\" />
		<Delete Files="$(PlatformSupportRoot)\SparkUpload\OpenViewLinux_TargetSupport.zip" />
	</Target>

	<Target Name="CreateOpenViewPublishOutputs" AfterTargets="PostBuildEvent" Condition="!Exists('$(PlatformSupportRoot)\SparkUpload\OpenViewLinux_TargetSupport.zip')">

		<!-- Copy BSP from Download Area -->
		<ItemGroup>
			<DISTRO_FIRMWARE Include="$(PlatformSupportRoot)FirmwareDownload\OpenViewLinux_TargetSupport\Firmware\**" />
			<PLATFORM_RESOURCES Include="$(PlatformSupportRoot)BuildOutputs\Platform\OpenViewLinux\**" />
		</ItemGroup>

		<!--Copy Distro and Upgrade Files-->
		<Copy SourceFiles="@(DISTRO_FIRMWARE)" DestinationFolder="$(PlatformSupportRoot)\PlatformSupport\OpenViewLinux_TargetSupport_Firmware\%(RecursiveDir)" />
		<Copy SourceFiles="@(PLATFORM_RESOURCES)" DestinationFolder="$(PlatformSupportRoot)\PlatformSupport\OpenViewLinux_TargetSupport\Resources\AhsokaLib\%(RecursiveDir)" />

		<!-- Create OpenView "Select" Target Support Package (For Prep, Runtimes, Etc.) -->
		<Exec Condition="true" Command="dotnet clean ../Ahsoka.Installer.UI/Ahsoka.Installer.UI.csproj" />
		<Exec Command="dotnet publish ../Ahsoka.Installer.UI/Ahsoka.Installer.UI.csproj -p:IS_DESKTOP=NO -p:PublishProfile=LinuxOutputs " />
		<WriteLinesToFile File="$(PlatformSupportRoot)\PlatformSupport\OpenViewLinux_TargetSupport\InstallerUI\InstallerVersion.txt" Lines="$(GitVersion_SemVer)" Overwrite="true" Encoding="UTF-8" />
		<WriteLinesToFile File="$(PlatformSupportRoot)\PlatformSupport\OpenViewLinux_TargetSupport\OpenViewLinux_TargetSupport.zip.customertools.version" Lines="$(GitVersion_SemVer)" Overwrite="true" Encoding="UTF-8" />
		<WriteLinesToFile File="$(PlatformSupportRoot)\PlatformSupport\OpenViewLinux_TargetSupport\OpenViewLinux_Firmware.zip.customertools.version" Lines="Firmware_$(OpenViewBSP.substring(20)).zip" Overwrite="true" Encoding="UTF-8" />

		<Exec Condition="true" Command="dotnet clean ../Ahsoka.CommandLine/Ahsoka.CommandLine.csproj" />
		<Exec Command="dotnet publish ../Ahsoka.CommandLine/Ahsoka.CommandLine.csproj -p:IS_DESKTOP=NO -p:PublishProfile=LinuxOutputs" />

		<!-- Dependencies for OpenView "Select" -->
		<ItemGroup>
			<OV_Firmware Include="$(PlatformSupportRoot)\BuildOutputs\Firmware\OpenViewLinux_TargetSupport\**" />
			<OV_HardwareDefs Include="*HardwareConfiguration.json" />
			<!--CAN Processor Support & ESP32 Firmware-->
		</ItemGroup>
		<Copy SourceFiles="@(OV_Firmware)" DestinationFolder="$(PlatformSupportRoot)\PlatformSupport\OpenViewLinux_TargetSupport\Resources\%(RecursiveDir)" />
		<Copy SourceFiles="@(OV_HardwareDefs)" DestinationFolder="$(PlatformSupportRoot)\PlatformSupport\OpenViewLinux_TargetSupport\Hardware\%(RecursiveDir)" />

		<!-- Create OpenView "Select" Package -->
		<ZipDirectory Overwrite="true" SourceDirectory="$(PlatformSupportRoot)\PlatformSupport\OpenViewLinux_TargetSupport\" DestinationFile="$(PlatformSupportRoot)\SparkUpload\OpenViewLinux_TargetSupport.zip" />
		<ZipDirectory Overwrite="true" SourceDirectory="$(PlatformSupportRoot)\PlatformSupport\OpenViewLinux_TargetSupport_Firmware\" DestinationFile="$(PlatformSupportRoot)\SparkUpload\Firmware_$(OpenViewBSP.substring(20)).zip" />

	</Target>

	<ItemGroup>
		<PackageReference Include="GitVersion.MsBuild" Version="[5.12.0]">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

</Project>
